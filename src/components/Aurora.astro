---
import { gradienteConico } from '../lib/aurora';
interface Props { cores?: readonly [string, string, string] }
const { cores } = Astro.props;
---
<div class="aurora" style={`--gradiente: ${gradienteConico(cores)}`} aria-hidden="true"></div>

<style>
  .aurora {
    position: fixed;
    inset: -45%;
    z-index: -1;
    background: var(--gradiente);
    filter: blur(58px);
    /* 0.36, não 0.42: a medição da Task 14 (docs/verificacao-visual.md) mostrou
       que o corpo de texto que fica direto sobre o céu — fora de qualquer
       cartão — caía para 3,85:1 no mundo Invasão Alienígena e 4,18:1 em Viagem
       no Tempo, abaixo do mínimo de 4,5:1. Escurecer o céu é o remédio previsto
       pelo plano; os acentos dourado e violeta são fixos e não se mexem. A
       0,36 o pior caso dos seis mundos é 4,71:1. */
    opacity: 0.36;
    animation: girar 90s linear infinite;
  }

  @keyframes girar {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora { animation: none; }
  }
</style>
