---
interface Props {
  etiqueta: string;
  titulo: string;
  ancora: string;
}
const { etiqueta, titulo, ancora } = Astro.props;
---
<article class="cartao" id={ancora}>
  <span class="etiqueta">{etiqueta}</span>
  <h3>{titulo}</h3>
  <div class="corpo">
    <slot />
  </div>
</article>

<style>
  .cartao {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-block-end: 16px;
    scroll-margin-top: 96px;
  }

  .cartao h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  /* .etiqueta é inline-block em global.css para abraçar só o texto, mas
     .cartao é flex column e align-items: stretch estica os filhos por
     padrão — sem isto, a etiqueta vira uma barra dourada do tamanho do
     cartão. align-self aqui, nunca align-items no .cartao (isso encolheria
     o .corpo, que precisa da largura toda para a barra lateral violeta). */
  .etiqueta {
    align-self: flex-start;
  }

  /* A barra lateral violeta cerca o conjunto do conteúdo, não cada parágrafo —
     necessário porque o corpo pode vir de render() com múltiplos <p> (livros). */
  .corpo {
    border-left: 3px solid var(--violeta);
    padding-left: 10px;
  }

  .corpo :global(p) {
    margin: 0;
    line-height: 1.55;
  }

  .corpo :global(p + p) {
    margin-top: 10px;
  }
</style>
