---
interface Props {
  titulo: string;
  ancora: string;
  /* Só o arquétipo felino passa este marcador. Antes existia uma etiqueta
     obrigatória que repetia o nome do subgênero em todo verbete — saiu porque
     quem está lendo a página de Space Opera já sabe que está em Space Opera.
     O felino é outra coisa: não é o mundo, é a natureza do arquétipo, e essa
     informação não aparece em nenhum outro lugar da página. */
  marcador?: string;
}
const { titulo, ancora, marcador } = Astro.props;
---
<article class="verbete" id={ancora}>
  {marcador && <span class="etiqueta">{marcador}</span>}
  <h3>{titulo}</h3>
  <div class="corpo">
    <slot />
  </div>
</article>

<style>
  /* Sem moldura e sem painel de propósito: os verbetes de uma seção formam um
     bloco contínuo, separado por espaço em branco. A moldura e a cor são
     responsabilidades da premissa sorteada no gerador, onde os trechos destacados
     ganham cor quando as peças estão destravadas ou mudam de cor quando travadas. */
  .verbete {
    display: flex;
    flex-direction: column;
    gap: 8px;
    /* Era 16px com moldura em volta. Sem ela, o espaço é a única coisa que
       separa um verbete do próximo, então precisa ser maior que o intervalo
       interno de 8px para a leitura não virar uma parede de texto. */
    margin-block-end: 32px;
    /* Os mesmos 96px do scroll-margin-top das quatro section[id] em
       mundos/[subgenero].astro, pelo mesmo motivo: dar folga para o título não
       parar debaixo da barra fixa do topo. Os dois valores devem mudar
       juntos. */
    scroll-margin-top: 96px;
  }

  /* Sem cor própria: herda o --texto-forte de h1/h2/h3, ou seja, branco no
     escuro e quase preto no claro. Já foi --destaque (dourado) e, por um
     momento, --apoio; a autora recusou os dois. O que separa um verbete do
     próximo é o peso e o tamanho do título mais a barra lateral do .corpo, que
     continua em --apoio — a única cor aqui. O acento ficou reservado ao título
     da página.

     Os 1.2rem existiam por contraste: em dourado o título ficava em 4,27:1 no
     pior mundo e só passava por ser tratado como texto grande, acima de 18,66px.
     Em --texto-forte esse piso desapareceu — são 6,86:1 no pior mundo, folga até
     no critério de texto pequeno —, então o tamanho hoje é escolha de hierarquia
     e pode encolher sem reprovar. Ver docs/verificacao-visual.md. */
  .verbete h3 {
    margin: 0;
    font-size: 1.2rem;
  }

  /* .etiqueta é inline-block em global.css para abraçar só o texto, mas
     .verbete é flex column e align-items: stretch estica os filhos por
     padrão — sem isto, o marcador vira uma barra da largura toda do verbete.
     align-self aqui, nunca align-items no .verbete (isso encolheria o .corpo,
     que precisa da largura toda para a barra lateral). */
  .etiqueta {
    align-self: flex-start;
  }

  /* A barra lateral de --apoio cerca o conjunto do conteúdo, não cada parágrafo —
     necessário porque o corpo pode vir de render() com múltiplos <p> (livros).
     Com a moldura fora, é ela que marca onde um verbete começa e termina. */
  .corpo {
    border-left: 3px solid var(--apoio);
    padding-left: 10px;
  }

  .corpo :global(p) {
    margin: 0;
    line-height: 1.55;
  }

  .corpo :global(p + p) {
    margin-top: 10px;
  }
</style>
