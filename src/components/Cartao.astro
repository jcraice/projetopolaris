---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  titulo: string;
  ancora: string;
  /* Só o arquétipo felino passa este marcador. Antes existia uma etiqueta
     obrigatória que repetia o nome do subgênero em todo verbete — saiu porque
     quem está lendo a página de Space Opera já sabe que está em Space Opera.
     O felino é outra coisa: não é o subgênero, é a natureza do arquétipo, e essa
     informação não aparece em nenhum outro lugar da página. */
  marcador?: string;
  /* "01 / 11", já formatado por numeracao() de src/lib/texto.ts. Opcional
     porque a amostra de /subgeneros/ não é lista numerada. */
  numero?: string;
  /* Um desenho ao lado do texto. Chegam as duas versões do mesmo desenho, não
     uma: o traço precisa ser claro no tema escuro e escuro no claro, e o tema
     do site é um atributo que um botão escreve, não a preferência do sistema —
     nenhuma consulta de mídia acerta isso. Quem troca é o CSS lá embaixo.

     Mora aqui, e não na página de arquétipos, porque aparência de verbete é
     responsabilidade do Cartão: se um cenário ganhar ilustração amanhã, ela
     entra igual sem a página inventar um segundo jeito de dispor as colunas. */
  ilustracao?: {
    temaClaro: ImageMetadata;
    temaEscuro: ImageMetadata;
    alt: string;
  };
}
const { titulo, ancora, marcador, numero, ilustracao } = Astro.props;

/* Largura de exibição, tirada do próprio arquivo: o gerador encaixa todo
   desenho numa caixa de 560px de lado, então a metade das medidas reais é a
   caixa de 280px na tela. Fixar um número aqui deformaria os desenhos altos —
   um desenho alto teria quase o dobro da altura do gato. */
const metade = (imagem?: ImageMetadata) => (imagem ? Math.round(imagem.width / 2) : 0);
---
<article class:list={['verbete', ilustracao && 'verbete--ilustrado']} id={ancora}>
  {/* O invólucro existe para o verbete ilustrado: é ele que vira a coluna de
      texto ao lado do desenho. Envolve sempre, mesmo sem ilustração, porque
      <slot /> só pode aparecer uma vez num componente Astro — dois ramos de
      marcação, um com invólucro e outro sem, deixariam o corpo vazio num dos
      dois. Sem ilustração ele é um filho único e não muda nada na tela. */}
  <div class="verbete__texto">
    {numero && <span class="verbete__numero">{numero}</span>}
    {marcador && <span class="etiqueta">{marcador}</span>}
    <h3>{titulo}</h3>
    <div class="corpo">
      <slot />
    </div>
  </div>
  {ilustracao && (
    <div class="ilustracao">
      <Image
        class="ilustracao__tema-escuro"
        src={ilustracao.temaEscuro}
        alt={ilustracao.alt}
        width={metade(ilustracao.temaEscuro)}
        densities={[1, 2]}
        loading="lazy"
      />
      {/* A mesma imagem descrita duas vezes seria lida duas vezes por leitor de
          tela, e só uma das duas está visível em cada tema. A que o tema não
          escolheu sai da árvore de acessibilidade com alt vazio. */}
      <Image
        class="ilustracao__tema-claro"
        src={ilustracao.temaClaro}
        alt=""
        aria-hidden="true"
        width={metade(ilustracao.temaClaro)}
        densities={[1, 2]}
        loading="lazy"
      />
    </div>
  )}
</article>

<style>
  /* Sem moldura e sem painel: a lista é de atlas, e o que separa um verbete do
     próximo é uma linha fina — a .lista-verbetes em volta desenha a primeira,
     em cima. Até a Carta Estelar essa separação era espaço em branco mais a
     barra lateral em --apoio no corpo; a barra saiu e a cor ficou só no
     número. */
  .verbete {
    display: flex;
    flex-direction: column;
    padding-block: 20px;
    border-bottom: 1px solid var(--borda-suave);
    /* Os mesmos 96px do scroll-margin-top das três section[id] em
       subgeneros/[subgenero].astro, pelo mesmo motivo: dar folga para o título não
       parar debaixo da barra fixa do topo. Os dois valores devem mudar
       juntos. */
    scroll-margin-top: 96px;
  }

  /* Sem cor própria: herda o --texto-forte de h1/h2/h3, ou seja, branco no
     escuro e quase preto no claro. Já foi --destaque (dourado) e, por um
     momento, --apoio; a autora recusou os dois. A letra é a Fraunces dos
     títulos, que vem de global.css. */
  .verbete h3 {
    margin: 0;
    font-size: 1.35rem;
  }

  .verbete__numero {
    font-family: var(--fonte-rotulo);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--destaque);
  }

  /* .etiqueta é inline-block em global.css para abraçar só o texto, mas
     .verbete é flex column e align-items: stretch estica os filhos por
     padrão — sem isto, o marcador vira uma barra da largura toda do verbete.
     align-self aqui, nunca align-items no .verbete (isso encolheria o .corpo,
     que precisa da largura toda). */
  .verbete__texto {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .etiqueta,
  .verbete__numero {
    align-self: flex-start;
  }

  .corpo :global(p) {
    margin: 0;
    line-height: 1.55;
  }

  .corpo :global(p + p) {
    margin-top: 10px;
  }

  /* O verbete ilustrado vira uma linha: a coluna de texto de um lado, o desenho
     do outro. Flex e não grade — a grade precisaria fazer o desenho atravessar
     as linhas do texto com `grid-row: 1 / -1`, e num contêiner sem linhas
     declaradas esse -1 aponta para a primeira linha, não para a última: o
     desenho ocupava uma célula só e empurrava a etiqueta e o título para
     lugares errados. Com flex não há linha nenhuma para contar. */
  .verbete--ilustrado {
    flex-direction: row;
    /* Pelo topo, por escolha da autora. O desenho é bem mais alto que as duas
       linhas de texto do verbete, então a sobra de altura tem de ir para algum
       lugar: centrado, ela se partia em dois vãos — um antes da etiqueta e
       outro antes da epígrafe —, e era o de cima que incomodava, porque
       parecia distância a mais entre dois verbetes irmãos. Assim a etiqueta
       encosta no verbete anterior como as outras e a sobra fica toda embaixo,
       onde lê como recuo do bloco. */
    align-items: flex-start;
    gap: 32px;
  }

  /* Sem o min-width a coluna de texto não encolhe abaixo do tamanho do seu
     conteúdo e empurra o desenho para fora da página em tela estreita. */
  .verbete--ilustrado .verbete__texto {
    flex: 1;
    min-width: 0;
  }

  .ilustracao {
    flex: none;
  }

  /* Sem `display` aqui de propósito: as duas imagens são irmãs e quem decide
     qual aparece são as regras de tema logo abaixo. Um `display: block` neste
     seletor venceria por especificidade — ele tem um tipo a mais que as classes
     de tema — e as duas versões do gato apareceriam empilhadas. */
  .ilustracao :global(img) {
    max-width: 100%;
    height: auto;
  }

  /* O escuro é o tema padrão e o único que existe sem JavaScript, então é a
     versão de traço claro que nasce visível. O claro entra por data-tema na
     raiz — o mesmo gatilho que Base.astro escreve antes da primeira pintura,
     e por isso a troca não pisca. */
  .ilustracao__tema-escuro {
    display: block;
  }

  .ilustracao__tema-claro {
    display: none;
  }

  :root[data-tema='claro'] .ilustracao__tema-escuro {
    display: none;
  }

  :root[data-tema='claro'] .ilustracao__tema-claro {
    display: block;
  }

  /* Abaixo da coluna estreita não há espaço para duas faixas: o desenho desce
     para baixo do texto, centrado, e o verbete volta a ser uma coluna só. */
  @media (max-width: 640px) {
    .verbete--ilustrado {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }

    .ilustracao {
      align-self: center;
    }
  }
</style>
