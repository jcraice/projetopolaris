---
/* Os ícones do "Como usar" da home, desenhados no traço da carta estelar:
   linha fina em --apoio e um ponto de --destaque em cada um. Decorativos — o
   título do passo ao lado já diz o que o ícone diz. */
interface Props {
  nome: 'bussola' | 'carta' | 'constelacao' | 'estrela';
}

const { nome } = Astro.props;
---
<svg class="icone" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true">
  {nome === 'bussola' && (
    <>
      <circle cx="20" cy="20" r="15" />
      <circle cx="20" cy="20" r="11" stroke-dasharray="1 3" />
      <path class="icone__acento" d="M20 8 L23 20 L20 32 L17 20 Z" />
      <path class="icone__cheio" d="M20 8 L23 20 L17 20 Z" />
    </>
  )}
  {nome === 'carta' && (
    <>
      <path d="M6 11 L15 7 L25 11 L34 7 L34 29 L25 33 L15 29 L6 33 Z" />
      <path d="M15 7 V29 M25 11 V33" />
      <path class="icone__acento" d="M10 24 Q15 18 20 22 T29 17" stroke-dasharray="2 2" />
      <circle class="icone__cheio" cx="29" cy="17" r="2" />
    </>
  )}
  {nome === 'constelacao' && (
    <>
      <path d="M7 28 L15 13 L25 19 L33 9 M25 19 L29 31" />
      <circle class="icone__ponto" cx="7" cy="28" r="2" />
      <circle class="icone__ponto" cx="15" cy="13" r="2" />
      <circle class="icone__cheio" cx="25" cy="19" r="2.6" />
      <circle class="icone__ponto" cx="33" cy="9" r="2" />
      <circle class="icone__ponto" cx="29" cy="31" r="2" />
    </>
  )}
  {nome === 'estrela' && (
    <>
      <circle cx="20" cy="20" r="15" stroke-dasharray="1 3" />
      <path class="icone__cheio" d="M20 8 L22.4 17.6 L32 20 L22.4 22.4 L20 32 L17.6 22.4 L8 20 L17.6 17.6 Z" />
    </>
  )}
</svg>

<style>
  .icone {
    display: block;
    flex: none;
  }

  .icone * {
    fill: none;
    stroke: var(--apoio);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icone .icone__acento {
    stroke: var(--destaque);
  }

  .icone .icone__cheio {
    fill: var(--destaque);
    stroke: none;
  }

  .icone .icone__ponto {
    fill: var(--apoio);
    stroke: none;
  }
</style>
