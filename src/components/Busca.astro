---
---
<div class="busca" id="busca">
  <label for="busca-campo" class="busca__rotulo">Buscar no acervo</label>
  <div class="busca__campo-wrap">
    <input
      id="busca-campo"
      class="busca__campo"
      type="search"
      role="combobox"
      aria-expanded="false"
      aria-controls="busca-lista"
      aria-autocomplete="list"
      autocomplete="off"
      placeholder="Buscar arquétipos, cenários, elementos e livros…"
    />
    <ul id="busca-lista" class="busca__lista" role="listbox" aria-label="Resultados da busca" hidden></ul>
  </div>
  <p id="busca-status" class="busca__status" role="status" aria-live="polite"></p>
</div>

<style>
  .busca {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1 1 220px;
    min-width: 180px;
    max-width: 320px;
  }

  /* Rótulo acessível sem ocupar espaço visual — o placeholder já comunica
     a função do campo para quem enxerga a tela. */
  .busca__rotulo {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .busca__campo-wrap {
    position: relative;
  }

  .busca__campo {
    width: 100%;
    background: var(--tinta);
    border: 2px solid var(--borda-suave);
    color: var(--texto);
    padding: 8px 12px;
    font-size: 0.85rem;
    font-family: inherit;
  }

  .busca__campo::placeholder {
    color: var(--apagado);
  }

  .busca__campo:focus-visible {
    outline: 3px solid var(--violeta);
    outline-offset: 2px;
  }

  .busca__lista {
    position: absolute;
    z-index: 20;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    margin: 0;
    padding: 4px;
    list-style: none;
    background: var(--painel);
    backdrop-filter: blur(9px);
    border: 2px solid var(--ouro);
    max-height: 60vh;
    overflow-y: auto;
    animation: busca-surgir 0.12s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .busca__lista { animation: none; }
  }

  @keyframes busca-surgir {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .busca__lista li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 10px;
    cursor: pointer;
  }

  .busca__lista li:hover,
  .busca__lista li.busca__opcao--ativa {
    background: color-mix(in srgb, var(--violeta) 25%, transparent);
  }

  .busca__titulo {
    color: var(--papel);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .busca__meta {
    color: var(--apagado);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .busca__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import { buscar, type ItemIndice } from '../lib/busca';

  const base = import.meta.env.BASE_URL;
  const raiz = base.endsWith('/') ? base : `${base}/`;

  const container = document.getElementById('busca');
  const campo = document.getElementById('busca-campo');
  const lista = document.getElementById('busca-lista');
  const status = document.getElementById('busca-status');

  const rotulosTipo: Record<string, string> = {
    arquetipo: 'Arquétipo',
    cenario: 'Cenário',
    elemento: 'Elemento',
    livro: 'Livro',
  };

  if (
    container instanceof HTMLElement &&
    campo instanceof HTMLInputElement &&
    lista instanceof HTMLUListElement &&
    status instanceof HTMLElement
  ) {
    let indice: ItemIndice[] | null = null;
    let carregando: Promise<ItemIndice[]> | null = null;
    let resultados: ItemIndice[] = [];
    let indiceAtivo = -1;

    // O índice só é baixado na primeira digitação (não no carregamento da
    // página) e nunca duas vezes: a promessa em andamento é reaproveitada
    // por quem digita rápido, em vez de disparar um novo fetch.
    //
    // As funções abaixo são expressões (`const nome = () => …`), não
    // declarações (`function nome() {}`): o TypeScript só propaga o
    // estreitamento de tipo do `instanceof` acima (campo, lista, status
    // deixam de ser `HTMLElement | null`) para dentro de funções que já
    // existem no momento em que a checagem roda — funções aninhadas
    // declaradas com `function` são hoisted e, por poderem em tese ser
    // chamadas de qualquer ponto do escopo, o TypeScript descarta o
    // estreitamento dentro delas. Expressões atribuídas a `const` não têm
    // esse problema.
    const obterIndice = async (): Promise<ItemIndice[]> => {
      if (indice) return indice;
      if (!carregando) {
        carregando = fetch(`${raiz}indice-busca.json`)
          .then((resposta) => resposta.json() as Promise<ItemIndice[]>)
          .catch((erro) => {
            carregando = null;
            throw erro;
          });
      }
      indice = await carregando;
      return indice;
    };

    const fecharLista = () => {
      lista.hidden = true;
      lista.innerHTML = '';
      campo.setAttribute('aria-expanded', 'false');
      campo.removeAttribute('aria-activedescendant');
      resultados = [];
      indiceAtivo = -1;
    };

    const atualizarAtivo = () => {
      const opcoes = lista.querySelectorAll('li');
      opcoes.forEach((opcao, i) => {
        const ativa = i === indiceAtivo;
        opcao.setAttribute('aria-selected', String(ativa));
        opcao.classList.toggle('busca__opcao--ativa', ativa);
        if (ativa) {
          campo.setAttribute('aria-activedescendant', opcao.id);
          opcao.scrollIntoView({ block: 'nearest' });
        }
      });
      if (indiceAtivo === -1) campo.removeAttribute('aria-activedescendant');
    };

    const renderizarResultados = () => {
      lista.innerHTML = '';
      indiceAtivo = -1;
      campo.removeAttribute('aria-activedescendant');

      if (resultados.length === 0) {
        status.textContent = 'Nenhum resultado encontrado.';
        lista.hidden = true;
        campo.setAttribute('aria-expanded', 'false');
        return;
      }

      resultados.forEach((item, i) => {
        const opcao = document.createElement('li');
        opcao.id = `busca-opcao-${i}`;
        opcao.setAttribute('role', 'option');
        opcao.tabIndex = -1;
        opcao.setAttribute('aria-selected', 'false');

        const titulo = document.createElement('span');
        titulo.className = 'busca__titulo';
        titulo.textContent = item.titulo;

        const meta = document.createElement('span');
        meta.className = 'busca__meta';
        meta.textContent = `${rotulosTipo[item.tipo] ?? item.tipo} · ${item.subgenero}`;

        opcao.append(titulo, meta);
        opcao.addEventListener('mousedown', (evento) => {
          // preventDefault evita o blur do campo antes do clique navegar,
          // o que fecharia a lista antes de lermos o alvo.
          evento.preventDefault();
          window.location.href = item.url;
        });
        lista.appendChild(opcao);
      });

      lista.hidden = false;
      campo.setAttribute('aria-expanded', 'true');
      status.textContent = `${resultados.length} resultado${resultados.length === 1 ? '' : 's'} encontrado${resultados.length === 1 ? '' : 's'}.`;
    };

    const tratarDigitacao = async () => {
      const consulta = campo.value;
      if (!consulta.trim()) {
        fecharLista();
        status.textContent = '';
        return;
      }

      let indiceCarregado: ItemIndice[];
      try {
        indiceCarregado = await obterIndice();
      } catch {
        status.textContent = 'Não foi possível carregar o índice de busca.';
        return;
      }

      // A consulta pode ter mudado enquanto o índice baixava; refaz a
      // leitura do campo para não exibir resultado de uma busca antiga.
      if (campo.value !== consulta) return;

      resultados = buscar(indiceCarregado, campo.value).slice(0, 10);
      renderizarResultados();
    };

    campo.addEventListener('input', () => {
      void tratarDigitacao();
    });

    campo.addEventListener('keydown', (evento) => {
      if (evento.key === 'ArrowDown') {
        if (resultados.length === 0) return;
        evento.preventDefault();
        indiceAtivo = (indiceAtivo + 1) % resultados.length;
        atualizarAtivo();
      } else if (evento.key === 'ArrowUp') {
        if (resultados.length === 0) return;
        evento.preventDefault();
        indiceAtivo = (indiceAtivo - 1 + resultados.length) % resultados.length;
        atualizarAtivo();
      } else if (evento.key === 'Enter') {
        if (indiceAtivo >= 0 && resultados[indiceAtivo]) {
          evento.preventDefault();
          window.location.href = resultados[indiceAtivo].url;
        }
      } else if (evento.key === 'Escape') {
        if (!lista.hidden) {
          evento.preventDefault();
          fecharLista();
        }
      }
    });

    document.addEventListener('click', (evento) => {
      if (!container.contains(evento.target as Node)) {
        fecharLista();
      }
    });
  }
</script>
