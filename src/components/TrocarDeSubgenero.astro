---
import { getCollection } from 'astro:content';

interface Props {
  /* O tipo de catálogo em que a pessoa está. A fileira leva ao mesmo tipo em
     outro subgênero — de Arquétipos Cyberpunk para Arquétipos Distopia, não
     para a porta de entrada do subgênero —, que é o que mantém a leitura no
     mesmo trilho. */
  tipo: 'arquetipos' | 'cenarios' | 'elementos';
  /* O subgênero aberto, que ganha a marca de página atual. Em /arquetipos/comuns/
     não corresponde a nenhuma pílula, e é de propósito: ver abaixo. */
  atual: string;
}

const { tipo, atual } = Astro.props;

/* Só os dez subgêneros completos: o pool dos 10 Arquétipos Comuns tem
   completo: false e não é destino de troca — a mesma regra que o mantém fora
   de /subgeneros/. Mas a página /arquetipos/comuns/ recebe a fileira assim
   mesmo, com nenhuma pílula marcada: ela é a única das quatro rotas
   [subgenero] que existe sem ser um subgênero completo, e sem isto
   continuaria sendo a única sem saída lateral nenhuma. */
const subgeneros = (await getCollection('subgeneros', (s) => s.data.completo)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);

const base = import.meta.env.BASE_URL;
const raiz = base.endsWith('/') ? base : `${base}/`;
---
{/* O subgênero aberto fica na fileira, marcado, em vez de ser omitido: assim a
    fileira é a mesma nas dez páginas — não muda de largura nem de ordem a cada
    troca — e ainda diz onde a pessoa está. É o que o rótulo "Trocar de
    subgênero" promete; "Outros subgêneros" pediria a lista sem ele.

    Quem carrega esse estado é o aria-current do próprio link, não uma classe,
    pelo mesmo motivo da barra do topo: a marca que o leitor de tela anuncia é a
    que o olho vê, sem um segundo estado para divergir dela. */}
<nav class="trocar-de-subgenero" aria-labelledby="trocar-de-subgenero-titulo">
  <h2 id="trocar-de-subgenero-titulo">Trocar de subgênero</h2>
  <ul class="lista-subgeneros">
    {subgeneros.map((m) => (
      <li>
        <a href={`${raiz}${tipo}/${m.id}/`} aria-current={m.id === atual ? 'page' : undefined}>
          {m.data.nome}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .trocar-de-subgenero {
    margin-block-start: 48px;
  }

  /* Rótulo de fileira, não título de seção: na letra dos rótulos, pequeno e
     em --apagado (5,88:1 no escuro, 5,52:1 no claro), para não chamar mais
     atenção que o último verbete logo acima. */
  h2 {
    font-family: var(--fonte-rotulo);
    font-weight: 400;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--apagado);
    margin-block-end: 16px;
  }
</style>
