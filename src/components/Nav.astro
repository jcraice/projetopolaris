---
import Busca from './Busca.astro';
import { ehPaginaAtual } from '../lib/navegacao';

const base = import.meta.env.BASE_URL;
const raiz = base.endsWith('/') ? base : `${base}/`;

const caminho = Astro.url.pathname;

// As três coleções que o gerador combina, mais a própria ação de gerar: é o
// que fica visível na barra. O resto entra no menu "Mais" — são páginas que se
// visita uma vez, não a cada volta ao site.
const links = [
  { rotulo: 'Arquétipos', href: `${raiz}arquetipos` },
  { rotulo: 'Cenários', href: `${raiz}cenarios` },
  { rotulo: 'Elementos', href: `${raiz}elementos` },
  { rotulo: 'Gerador', href: `${raiz}gerador` },
];

const linksDeMais = [
  { rotulo: 'Estilos', href: `${raiz}estilos` },
  { rotulo: 'Sobre', href: `${raiz}sobre` },
];

// O botão acende junto quando a página aberta é uma das três de dentro dele:
// fechado, o menu esconderia a única marca de onde a pessoa está.
const maisEhAtual = linksDeMais.some((link) => ehPaginaAtual(caminho, link.href));
---
<header class="nav">
  <a class="nav__marca" href={base}>POLARIS</a>
  {/* Nasce escondido e só aparece por JavaScript — ver ligarExpansivel. Sem
      script, este botão não existe e os links ficam sempre visíveis. */}
  <button
    type="button"
    class="nav__abrir"
    id="abrir-menu"
    hidden
    aria-expanded="false"
    aria-controls="nav-links busca"
    aria-label="Abrir e fechar o menu"
  >
    <svg class="nav__icone-abrir" viewBox="0 0 24 24" width="22" height="22"
         fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
    <svg class="nav__icone-fechar" viewBox="0 0 24 24" width="22" height="22"
         fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
  <nav class="nav__links" id="nav-links" aria-label="Navegação principal">
    {links.map((link) => (
      <a href={link.href} aria-current={ehPaginaAtual(caminho, link.href) ? 'page' : undefined}>
        {link.rotulo}
      </a>
    ))}
    {/* Mesmo contrato do botão do menu: nasce com [hidden] e só aparece pelo
        JavaScript. Sem script os três links de dentro ficam soltos na barra,
        como estavam antes do menu existir, em vez de virarem um "Mais" que
        não abre. */}
    <div class="nav__mais">
      <button
        type="button"
        class:list={['nav__mais-botao', maisEhAtual && 'nav__mais-botao--atual']}
        id="abrir-mais"
        hidden
        aria-expanded="false"
        aria-controls="submenu-mais"
      >
        Mais
        <svg class="nav__seta" viewBox="0 0 24 24" width="14" height="14"
             fill="none" stroke="currentColor" stroke-width="3"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 9l7 7 7-7" />
        </svg>
      </button>
      <div class="nav__submenu" id="submenu-mais">
        {linksDeMais.map((link) => (
          <a href={link.href} aria-current={ehPaginaAtual(caminho, link.href) ? 'page' : undefined}>
            {link.rotulo}
          </a>
        ))}
      </div>
    </div>
  </nav>
  <Busca />
  {/* O ícone mostra o tema que o clique traz, não o que está valendo: sol
      quando a tela está escura, lua quando está clara. */}
  <button type="button" class="tema" id="alternar-tema" aria-label="Alternar entre tema claro e escuro">
    <svg class="tema__sol" viewBox="0 0 24 24" width="20" height="20"
         fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
    </svg>
    <svg class="tema__lua" viewBox="0 0 24 24" width="20" height="20"
         fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
    </svg>
  </button>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    /* Acima de qualquer descendente posicionado do <main>, que vem depois na
       ordem do documento e sem isto pintaria por cima da barra ao rolar. A lista
       da busca (z-index: 20) segue funcionando dentro do contexto de empilhamento
       que este z-index cria. */
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px var(--recuo);
    border-bottom: 2px solid var(--borda-suave);
    background: var(--painel);
    backdrop-filter: blur(9px);
  }

  /* No claro --painel é rgba(20, 24, 31, 0.05), e cinco por cento não seguram o
     texto que passa por baixo de uma barra fixa: ele apareceria atrás dos
     links. Aqui a barra é opaca, e o backdrop-filter sai junto porque não tem
     mais o que borrar — deixa de custar uma recomposição por quadro de
     rolagem, o mesmo raciocínio que tirou a aurora inteira do tema claro.

     Contraste: --painel não muda de valor, e esta superfície já está medida em
     docs/verificacao-visual.md, na coluna "sobre o fundo #f5f7f9" da tabela do
     tema claro — --texto em 11,47 e --texto-forte em 16,57. */
  :global(html[data-tema='claro']) .nav {
    background: var(--fundo);
    backdrop-filter: none;
  }

  .nav__marca {
    font-weight: 900;
    font-size: 1.3rem;
    letter-spacing: 0.08em;
    color: var(--texto-forte);
    text-decoration: none;
  }

  .nav__links {
    display: flex;
    flex-wrap: wrap;
    /* Era 18px. Encolheu porque o padding dos links agora separa um do outro
       por conta própria — sem isso, padding somado ao intervalo antigo faria
       a navegação quebrar em mais fileiras no celular. */
    gap: 12px;
    /* Estica na altura da barra para o submenu poder se pendurar nela: o `top`
       do painel conta a partir do fim de .nav__mais, e sem isto esse fim
       ficaria no meio da barra, à mercê da altura da busca e dos dois ícones —
       o encaixe sairia desalinhado por alguns pixels sem nada no CSS explicar
       por quê. O align-items devolve os links ao centro, que é onde eles
       estavam quando a lista tinha a altura do próprio conteúdo. */
    align-self: stretch;
    align-items: center;
  }

  .nav__links a {
    color: var(--texto);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    /* Sem padding estes links eram texto nu de ~16px de altura, os menores
       alvos de toque do site. Com 8px em cima e embaixo passam de 30px, acima
       dos 24px que o WCAG 2.2 AA pede em "Target Size (Minimum)". O padding
       lateral é pequeno de propósito: alargar demais empurraria a navegação
       para mais uma fileira em tela estreita. */
    padding: 8px 4px;
  }

  .nav__links a:hover {
    color: var(--destaque);
  }

  /* A página aberta fica pintada com --flutuante, a mesma superfície do painel
     do "Mais": marcar onde a pessoa está não introduz nenhum tom novo na
     barra, é a cor de fundo que ela já tinha.

     O recuo lateral cresce de 4 para 10px e a margem negativa devolve os 6px,
     então a caixa de fora do link continua do mesmo tamanho e nada na fileira
     se desloca ao trocar de página — o mesmo arranjo do botão aberto. O que a
     pintura ganha são 6px dos 12 de intervalo de cada lado; os outros 6
     continuam de barra, separando o link pintado dos vizinhos.

     Quem manda aqui é o aria-current, não uma classe: a mesma marca que o
     leitor de tela anuncia é a que o olho vê, sem um segundo estado para
     divergir dela. */
  .nav__links a[aria-current='page'],
  .nav__mais-botao--atual {
    background: var(--flutuante);
    border-radius: var(--raio);
    padding-inline: 10px;
    margin-inline: -6px;
  }

  .nav__mais {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    /* Pelo mesmo motivo de .nav__links: é o fim deste elemento que o `top` do
       painel usa como origem. */
    align-self: stretch;
  }

  /* Sem JavaScript o botão não existe e isto é o que se vê: os três links em
     fila, dentro da mesma linha dos outros. */
  .nav__submenu {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Herda de .nav__links a tudo que é tipografia; o que muda é ser botão. */
  .nav__mais-botao {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 4px;
    border: 0;
    background: transparent;
    color: var(--texto);
    font-family: inherit;
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    border-radius: var(--raio);
  }

  .nav__mais-botao:hover,
  .nav__mais-botao[aria-expanded='true'] {
    color: var(--destaque);
  }

  /* Aberto, o botão deixa de ser um botão solto e vira o topo do painel: mesmo
     fundo, cantos arredondados só em cima. O recuo lateral cresce para o do
     painel e a margem negativa devolve a diferença, então nada na barra se
     desloca no instante em que o menu abre. */
  .nav__mais-botao:not([hidden])[aria-expanded='true'] {
    background: var(--flutuante);
    border-radius: var(--raio) var(--raio) 0 0;
    padding-inline: 10px;
    margin-inline: -6px;
  }

  .nav__mais-botao:focus-visible {
    outline: 3px solid var(--apoio);
    outline-offset: 2px;
  }

  .nav__mais-botao[hidden] {
    display: none;
  }

  .nav__seta {
    transition: transform 0.15s ease;
  }

  .nav__mais-botao[aria-expanded='true'] .nav__seta {
    transform: rotate(180deg);
  }

  /* Existindo o botão, os três links viram painel, com a mesma entrada de
     0,12s da lista de resultados da busca, porque são as duas únicas coisas do
     site que abrem por cima da página.

     Ele não flutua e não tem moldura: encosta na linha da barra, com os cantos
     de cima retos, e o botão acende no mesmo fundo — os dois leem como uma
     peça só pendurada na barra. A moldura de 2px em --destaque que havia aqui
     foi recusada pela autora: uma caixinha boiando com contorno amarelo era a
     coisa mais chamativa da tela, para um menu de três páginas que se visita
     uma vez.

     O que muda em relação à busca é o fundo, e é de propósito: --flutuante
     opaco em vez de --painel com blur. O --painel é translúcido nos dois temas
     — e no escuro é a mesma cor de --fundo a 80%, então nem serviria de atalho
     para clarear o painel — e este menu abre bem em cima do h1, que é o texto
     maior e mais colorido da página. No claro o título aparecia inteiro atrás
     dos links; no escuro, borrado mas ainda legível. Texto por cima de texto
     não se resolve com blur, se resolve tapando. Por que --flutuante e não
     --fundo puro está no comentário do token, em global.css. */
  .nav__mais-botao:not([hidden]) ~ .nav__submenu {
    position: absolute;
    z-index: 20;
    /* Os 18px são o que sobra da barra debaixo da lista de links: 16px de
       recuo mais os 2px da borda de baixo. É o align-self: stretch de
       .nav__links e .nav__mais que faz essa conta fechar. Mexeu no padding da
       barra? Este número muda junto. */
    top: calc(100% + 18px);
    left: -6px;
    display: none;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    min-width: 180px;
    padding: 4px;
    background: var(--flutuante);
    border-radius: 0 0 var(--raio) var(--raio);
    animation: submenu-surgir 0.12s ease-out;
  }

  /* Mesma especificidade da regra acima; quem decide é vir depois. */
  .nav__mais-botao[aria-expanded='true'] ~ .nav__submenu {
    display: flex;
  }

  .nav__submenu a {
    padding: 8px 10px;
    border-radius: var(--raio);
  }

  .nav__submenu a:hover {
    background: color-mix(in srgb, var(--apoio) 25%, transparent);
  }

  /* Dentro do painel aberto a pintura da barra não serve: o painel já é
     --flutuante, e o link atual sumiria de violeta sobre violeta. Aqui ele usa
     a mesma camada do item sob o cursor, que é a única superfície mais alta
     que o painel tem. Os recuos voltam aos do painel — os -6px da barra o
     fariam vazar pelas laterais. */
  .nav__mais-botao:not([hidden]) ~ .nav__submenu a[aria-current='page'] {
    background: color-mix(in srgb, var(--apoio) 25%, transparent);
    margin-inline: 0;
    padding-inline: 10px;
  }

  @keyframes submenu-surgir {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__seta { transition: none; }
    .nav__mais-botao:not([hidden]) ~ .nav__submenu { animation: none; }
  }

  /* O botão do menu só existe abaixo do ponto de quebra; acima, os sete links
     cabem na fileira e um menu recolhido só atrapalharia. */
  .nav__abrir {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--texto);
    cursor: pointer;
    border-radius: var(--raio);
  }

  .nav__abrir:hover {
    color: var(--destaque);
  }

  .nav__abrir:focus-visible {
    outline: 3px solid var(--apoio);
    outline-offset: 2px;
  }

  /* [hidden] precisa ser reafirmado: a regra de display acima venceria o
     display:none que o navegador dá ao atributo, e o botão apareceria mesmo
     sem JavaScript, sem abrir nada. */
  .nav__abrir[hidden] {
    display: none;
  }

  .nav__icone-fechar {
    display: none;
  }

  .nav__abrir[aria-expanded='true'] .nav__icone-abrir {
    display: none;
  }

  .nav__abrir[aria-expanded='true'] .nav__icone-fechar {
    display: block;
  }

  /* O ponto de quebra não é uma medida redonda de tablet: quem manda é a soma do
     conteúdo, e ela mudou quando os links de leitura entraram no menu "Mais".
     Medido no navegador, a barra numa linha só pede 862px — 102 da marca, 468
     dos quatro links mais o botão "Mais", 180 da busca (o min-width dela, que é
     o quanto ela cede antes de apertar), 36 do botão de tema, 36 dos três
     intervalos de 12px e 40 dos dois recuos de 20px, que é o valor de --recuo
     abaixo de 1280px. Eram cerca de 1030px na época em que todos os links
     ficavam soltos na barra, e por isso o ponto ficava em 1080.

     O que entra e sai do painel do "Mais" não mexe nesta conta — só o que fica
     na barra conta. Foi o caso de Livros, que saiu do painel sem mover o 920.

     Os 920px de hoje guardam a mesma folga de uns 50px que o 1080 guardava:
     abaixo dela o header se desfaz item a item — primeiro o botão de tema cai
     para a segunda linha, depois a busca —, que é o que este recolhimento
     evita. Mexeu no que está na barra? A conta muda junto.

     A busca entra no menu junto com os links. Ela sozinha pede 180px, e marca
     mais busca mais dois ícones não cabem na largura de um celular: mantê-la
     fora obrigaria a segunda linha a voltar em tela estreita. */
  @media (max-width: 919px) {
    .nav__abrir:not([hidden]) {
      display: flex;
      order: 3;
    }

    /* O `:not([hidden])` é o que amarra as duas coisas: a lista só se esconde
       se existir um botão capaz de trazê-la de volta. */
    .nav__abrir:not([hidden]) ~ .nav__links,
    .nav__abrir:not([hidden]) ~ :global(.busca) {
      display: none;
    }

    .nav__abrir[aria-expanded='true'] ~ .nav__links {
      display: flex;
      flex-direction: column;
      /* Desfaz o align-items: center da regra base, que aqui centralizaria os
         links na horizontal e encolheria as bordas de baixo junto com eles. */
      align-items: stretch;
      gap: 0;
      width: 100%;
      order: 5;
      /* Com a barra fixa, o menu aberto não pode passar da tela: sticky grudado
         no topo não se move, e o que sobrar embaixo fica inalcançável. Acontece
         em celular na horizontal, onde a altura é 375px e a barra aberta pede
         uns 400px.

         Os 150px são o que fica acima e abaixo da lista dentro da barra: 16px
         de recuo, ~36px da fileira da marca, 12px de intervalo, ~44px da busca,
         12px de intervalo e 16px de recuo — soma 136px, arredondado para cima
         para deixar folga.

         O teto vai na lista, e não no <header>: .busca__lista é absolute dentro
         da busca, e overflow-y no header cortaria os resultados em vez de
         deixá-los sobrepor a página. Em tela de pé a lista cabe e nada disto
         entra em ação.

         A regra base de .nav__links tem flex-wrap: wrap, e com o teto de altura
         uma coluna flex que quebra passa a distribuir os itens em várias colunas
         em vez de rolar — por isso o flex-wrap: nowrap abaixo. Quem o remover
         quebra a rolagem interna. */
      max-height: calc(100dvh - 150px);
      overflow-y: auto;
      flex-wrap: nowrap;
    }

    .nav__abrir[aria-expanded='true'] ~ :global(.busca) {
      display: flex;
      width: 100%;
      max-width: none;
      order: 4;
    }

    /* Dentro do menu recolhido não existe "Mais": seria um menu que abre dentro
       de outro menu, com dois aria-expanded para a mesma pessoa administrar.
       O display: contents dissolve o agrupamento e devolve os três links à
       condição de irmãos dos outros quatro — a mesma lista corrida que o
       celular tinha antes deste menu existir. */
    .nav__mais {
      display: contents;
    }

    .nav__mais-botao {
      display: none;
    }

    .nav__mais-botao:not([hidden]) ~ .nav__submenu,
    .nav__mais-botao[aria-expanded='true'] ~ .nav__submenu {
      display: contents;
    }

    .nav__abrir[aria-expanded='true'] ~ .nav__links a {
      padding: 10px 0;
      border-bottom: 2px solid var(--borda-suave);
      /* Sem isto os links encolhem para caber no teto de altura em vez de a
         lista rolar, e o alvo de toque de 40px (os 10px de padding em cima e
         embaixo) some junto. */
      flex-shrink: 0;
    }

    /* Dentro do menu recolhido a página atual é uma faixa, não uma pastilha:
       aqui os links já ocupam a linha inteira, e os -6px da barra larga fariam
       a pintura vazar para fora da coluna. */
    .nav__abrir[aria-expanded='true'] ~ .nav__links a[aria-current='page'] {
      margin-inline: 0;
      padding-inline: 8px;
    }

    /* Aqui não existe painel — os três links do "Mais" viraram irmãos dos
       outros quatro —, então o de dentro dele volta a ser faixa como o resto,
       desfazendo a regra do painel aberto. */
    .nav__abrir[aria-expanded='true'] ~ .nav__links .nav__submenu a[aria-current='page'] {
      background: var(--flutuante);
      padding-inline: 8px;
    }

    /* A marca empurra o resto para a direita e os dois ícones ficam colados,
       como um par só, em vez de espalhados pela linha. */
    .nav__marca {
      margin-right: auto;
      order: 1;
    }

    .tema {
      order: 2;
    }
  }

  .tema {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Mesmos 36px do cadeado do gerador, pelo mesmo motivo: alvo de toque
       confortável em volta de um ícone discreto de 20px. */
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--texto);
    cursor: pointer;
    transition: color 0.15s ease;
    border-radius: var(--raio);
  }

  .tema:hover {
    color: var(--destaque);
  }

  .tema:focus-visible {
    outline: 3px solid var(--apoio);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tema { transition: none; }
  }

  /* O estado padrão é o escuro, que é o que vale sem JavaScript — por isso o
     sol aparece por omissão e a lua só quando o tema claro está ligado. */
  .tema__lua {
    display: none;
  }

  :global(html[data-tema='claro']) .tema__sol {
    display: none;
  }

  :global(html[data-tema='claro']) .tema__lua {
    display: block;
  }
</style>

<script>
  import { ehTeclaDeFechar, ligarExpansivel } from '../lib/expansivel';

  ligarExpansivel(document.getElementById('abrir-menu'));

  // O "Mais" abre e fecha pelo mesmo mecanismo dos outros expansíveis, e ganha
  // por cima o que só faz sentido para um painel que cobre a página.
  const botaoDeMais = document.getElementById('abrir-mais');
  ligarExpansivel(botaoDeMais);

  if (botaoDeMais instanceof HTMLButtonElement) {
    const grupo = botaoDeMais.closest('.nav__mais');
    const fecharMais = () => botaoDeMais.setAttribute('aria-expanded', 'false');
    const estaAberto = () => botaoDeMais.getAttribute('aria-expanded') === 'true';

    // Clique fora fecha. O listener fica no documento, e não no grupo, porque o
    // que interessa é o que acontece longe dele; cliques dentro passam pelo
    // contains e não fazem nada, inclusive o do próprio botão, que o
    // ligarExpansivel já tratou.
    document.addEventListener('click', (evento) => {
      if (grupo && !grupo.contains(evento.target as Node)) fecharMais();
    });

    document.addEventListener('keydown', (evento) => {
      if (!ehTeclaDeFechar(evento.key) || !estaAberto()) return;
      fecharMais();
      // O foco volta para o botão: sem isto ele fica preso num link que acabou
      // de sumir da tela, e o próximo Tab recomeça do topo da página.
      botaoDeMais.focus();
    });
  }

  const botao = document.getElementById('alternar-tema');
  const preferenciaClara = window.matchMedia('(prefers-color-scheme: light)');

  const lerEscolha = (): string | null => {
    try {
      return localStorage.getItem('polaris-tema');
    } catch {
      return null;
    }
  };

  if (botao instanceof HTMLButtonElement) {
    botao.addEventListener('click', () => {
      const novo = document.documentElement.dataset.tema === 'claro' ? 'escuro' : 'claro';
      document.documentElement.dataset.tema = novo;
      try {
        localStorage.setItem('polaris-tema', novo);
      } catch {
        // Sem onde guardar, a escolha vale só para esta página. Preferível a
        // quebrar o botão em quem navega com armazenamento bloqueado.
      }
    });
  }

  // Só acompanha o sistema enquanto ninguém escolheu explicitamente: depois de
  // um clique, a escolha da pessoa vence a preferência do sistema.
  preferenciaClara.addEventListener('change', (evento) => {
    if (lerEscolha()) return;
    document.documentElement.dataset.tema = evento.matches ? 'claro' : 'escuro';
  });
</script>
