---
import { getCollection } from 'astro:content';

/* As três opções que valem para os dois modos do gerador: em que mundo sortear,
   se pode misturar mundos e se os 20 arquétipos comuns entram. O `<script>` da
   página lê tudo por FormData, então os atributos `name` são contrato: precisam
   casar com as chaves de `Opcoes`.

   Os mundos são buscados aqui, e não recebidos por prop, porque são sempre os
   mesmos seis em qualquer página que ofereça sorteio — `mundo: false` fica de
   fora, que é o pool `comuns`, oferecido pela terceira opção. */
const mundos = (await getCollection('subgeneros', (s) => s.data.mundo)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);
---
<form id="opcoes">
  <fieldset>
    <legend>Opções do sorteio</legend>
    <label for="opcoes-mundo">
      Mundo
      <select id="opcoes-mundo" name="subgenero">
        {mundos.map((m) => <option value={m.id}>{m.data.nome}</option>)}
      </select>
    </label>
    <label><input type="checkbox" name="misturarMundos" /> Misturar mundos</label>
    <label><input type="checkbox" name="incluirComuns" /> Incluir os 20 arquétipos comuns</label>
  </fieldset>
</form>

<style>
  fieldset {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    border: 2px solid var(--borda-suave);
    padding: 14px 18px;
    margin: 0 0 24px;
  }

  legend {
    padding: 0 6px;
    font-weight: 900;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--apagado);
  }

  label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }

  select {
    background: var(--fundo);
    color: var(--texto);
    border: 2px solid var(--borda-suave);
    padding: 6px 10px;
    font-family: inherit;
    /* 1rem pelo mesmo motivo do campo de busca: abaixo de 16px o Safari do
       iPhone amplia a página ao abrir o seletor. */
    font-size: 1rem;
    border-radius: var(--raio);
  }

  select:focus-visible,
  input:focus-visible {
    outline: 3px solid var(--apoio);
    outline-offset: 3px;
  }
</style>
