---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · Projeto Polaris</title>
    {/* Os três saem de scripts/gerar-favicon.py. O .ico vem antes e com
        `sizes` para o navegador que entende SVG preferir o .svg, que troca de
        versão conforme a aba seja clara ou escura. */}
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <Font cssVariable="--fonte-titulo" preload />
    <Font cssVariable="--fonte-texto" preload />
    <Font cssVariable="--fonte-rotulo" />
    {/* is:inline e aqui no <head> de propósito: este script precisa rodar antes
        da primeira pintura, senão a página aparece escura por um instante antes
        de virar clara. Um script processado pelo Astro seria adiado e piscaria.
        localStorage dentro de try porque ele lança em algumas configurações de
        privacidade — nesse caso o site simplesmente segue o sistema. */}
    <script is:inline>
      (() => {
        let escolhido = null;
        try {
          escolhido = localStorage.getItem('polaris-tema');
        } catch {}
        const claro = escolhido
          ? escolhido === 'claro'
          : window.matchMedia('(prefers-color-scheme: light)').matches;
        document.documentElement.dataset.tema = claro ? 'claro' : 'escuro';
      })();
    </script>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <footer class="rodape">
      <p>
        Código sob licença MIT. Conteúdo editorial sob licença Creative
        Commons Atribuição 4.0 Internacional (CC BY 4.0).
      </p>
    </footer>
  </body>
</html>

<style>
  main {
    padding: 24px var(--recuo);
  }

  .rodape {
    padding: 20px var(--recuo);
    border-top: 2px solid var(--borda-suave);
    color: var(--apagado);
    font-size: 0.8rem;
  }
</style>
