---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cartao from '../../components/Cartao.astro';
import { paraAncora } from '../../lib/texto';

// O pool "10 Arquétipos Comuns" tem completo: false — não é um subgênero
// completo, então não entra aqui. As dez páginas de subgênero são as únicas geradas por esta rota.
export async function getStaticPaths() {
  const subgeneros = await getCollection('subgeneros', (s) => s.data.completo);
  return subgeneros.map((s) => ({ params: { subgenero: s.id }, props: { subgenero: s } }));
}

const { subgenero } = Astro.props;

// Esta página é a porta de entrada de um subgênero, não o catálogo dele: mostra uma
// amostra de cada tipo e manda para a página completa. Antes listava tudo, o
// que deixava o "Ver todos" sem sentido — ele levava para a mesma coisa que já
// estava na tela, depois de dezenas de verbetes de rolagem.
const PREVIA = 3;

const porOrdem = (a: { data: { ordem: number } }, b: { data: { ordem: number } }) =>
  a.data.ordem - b.data.ordem;

// O arquétipo felino fica de fora da amostra e aparece só na página completa:
// ele é o décimo primeiro de cada subgênero, não um dos três primeiros.
const arquetipos = (await getCollection('arquetipos', (a) => a.data.subgenero === subgenero.id && !a.data.felino))
  .sort(porOrdem)
  .slice(0, PREVIA);

const cenarios = (await getCollection('cenarios', (c) => c.data.subgenero === subgenero.id))
  .sort(porOrdem)
  .slice(0, PREVIA);

const elementos = (await getCollection('elementos', (e) => e.data.subgenero === subgenero.id))
  .sort(porOrdem)
  .slice(0, PREVIA);

const base = import.meta.env.BASE_URL;
const raiz = base.endsWith('/') ? base : `${base}/`;
---
<Base titulo={`${subgenero.data.nome}: arquétipos, cenários e elementos narrativos`} descricao={subgenero.body ?? ''}>
  <p class="rotulo">Subgênero</p>
  <h1>{subgenero.data.nome}</h1>
  <p class="abertura">{subgenero.body}</p>

  <nav class="sumario" aria-label="Sumário do subgênero">
    <a href="#arquetipos">Arquétipos</a>
    <a href="#cenarios">Cenários</a>
    <a href="#elementos">Elementos Narrativos</a>
  </nav>

  <section id="arquetipos" aria-labelledby="arquetipos-titulo">
    <div class="titulo-linha">
      <h2 id="arquetipos-titulo">Arquétipos</h2>
      <a class="ver-tudo" href={`${raiz}arquetipos/${subgenero.id}/`}>Ver todos →</a>
    </div>
    <div class="lista-verbetes">
    {arquetipos.map((f) => (
      <Cartao titulo={f.data.nome} ancora={`arquetipos-${paraAncora(f.data.nome)}`}>
        <p>{f.body}</p>
      </Cartao>
    ))}
    </div>
  </section>

  <section id="cenarios" aria-labelledby="cenarios-titulo">
    <div class="titulo-linha">
      <h2 id="cenarios-titulo">Cenários</h2>
      <a class="ver-tudo" href={`${raiz}cenarios/${subgenero.id}/`}>Ver todos →</a>
    </div>
    <div class="lista-verbetes">
    {cenarios.map((c) => (
      <Cartao titulo={c.data.titulo} ancora={`cenarios-${paraAncora(c.data.titulo)}`}>
        <p>{c.body}</p>
      </Cartao>
    ))}
    </div>
  </section>

  <section id="elementos" aria-labelledby="elementos-titulo">
    <div class="titulo-linha">
      <h2 id="elementos-titulo">Elementos Narrativos</h2>
      <a class="ver-tudo" href={`${raiz}elementos/${subgenero.id}/`}>Ver todos →</a>
    </div>
    <div class="lista-verbetes">
    {elementos.map((e) => (
      <Cartao titulo={e.data.titulo} ancora={`elementos-${paraAncora(e.data.titulo)}`}>
        <p>{e.body}</p>
      </Cartao>
    ))}
    </div>
  </section>
</Base>

<style>
  .sumario {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-block: 20px 32px;
  }

  .sumario a {
    color: var(--texto);
    text-decoration: none;
    font-family: var(--fonte-rotulo);
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    border-bottom: 1px solid var(--apoio);
  }

  .sumario a:hover {
    color: var(--destaque);
    border-color: var(--destaque);
  }

  section + section {
    margin-block-start: 40px;
  }

  /* As três seções são alvo do sumário logo acima. Sem folga, o <h2> para
     debaixo da barra fixa do topo. Os mesmos 96px do scroll-margin-top dos
     verbetes em Cartao.astro, pelo mesmo motivo: a barra recolhida tem cerca de
     68px e o resto é respiro. */
  section[id] {
    scroll-margin-top: 96px;
  }

  /* O título de seção e o "Ver todos" alinhados pela base. */
  .titulo-linha {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* Foi uma pastilha preenchida de --destaque, com sombra deslocada em
     --apoio, até a Carta Estelar: o laranja passou a ser reservado a poucas
     peças (rótulo, numeração, botão principal) e o título de seção voltou a
     ser Fraunces em --texto-forte, maior que o nome dos verbetes abaixo para a
     página não ler como um bloco só. */
  h2 {
    font-size: 1.8rem;
    margin: 0;
  }

  .ver-tudo {
    font-family: var(--fonte-rotulo);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--apoio);
  }

  .ver-tudo:hover {
    color: var(--destaque);
  }
</style>
