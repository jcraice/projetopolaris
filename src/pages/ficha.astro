---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import CartaSorteada from '../components/CartaSorteada.astro';
import OpcoesDoSorteio from '../components/OpcoesDoSorteio.astro';
import { redigirFicha } from '../lib/gerador';

const pagina = await getEntry('paginas', 'ficha');
if (!pagina) throw new Error("página 'ficha' não encontrada em src/content/paginas");
if (!pagina.body) throw new Error("página 'ficha' está sem corpo em src/content/paginas");

const mundos = (await getCollection('subgeneros', (s) => s.data.mundo)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);
const nomesDosMundos = Object.fromEntries(mundos.map((m) => [m.id, m.data.nome]));

/* Mesma proteção do prompt, pelo mesmo motivo: `redigirFicha` estoura em
   marcador desconhecido, e uma chamada aqui em tempo de build faz um
   `[PERSONAGEM C]` no ficha.md quebrar `npm run build` — o portão que o deploy
   roda — em vez de chegar em produção e deixar o texto pela metade. Os valores
   são de descarte; quem importa são os marcadores do molde. */
const descarte = { id: 'x', nome: 'conferência', subgenero: 'x' };
redigirFicha(
  pagina.body,
  {
    personagemA: descarte,
    personagemB: descarte,
    cenario: { ...descarte, singular: 'uma conferência' },
    complicacao: 'conferência',
    familia: 'conferência',
  },
  'conferência',
);

/* A ficha não usa elemento narrativo, então os 120 elementos não são injetados —
   só os 146 arquétipos e os 60 cenários. O campo existe no tipo `Pools` porque é
   o mesmo `poolsFiltrados` que serve aos dois modos, e vai vazio de propósito. */
const pools = {
  arquetipos: (await getCollection('arquetipos')).map((a) => ({
    id: a.id, nome: a.data.nome, subgenero: a.data.subgenero,
  })),
  cenarios: (await getCollection('cenarios')).map((c) => ({
    id: c.id, nome: c.data.titulo, subgenero: c.data.subgenero, singular: c.data.singular,
  })),
  elementos: [],
};

/* Os rótulos casam com os campos de SorteioFicha: é por `data-carta` que o
   script acha cada carta, e por `data-travar` que sabe qual trava alternar. */
const CARTAS = [
  { tipo: 'personagemA', rotulo: 'Personagem A' },
  { tipo: 'personagemB', rotulo: 'Personagem B' },
  { tipo: 'cenario', rotulo: 'Local' },
] as const;

const base = import.meta.env.BASE_URL;
const raiz = base.endsWith('/') ? base : `${base}/`;
---
<Base titulo={pagina.data.titulo}>
  <h1>{pagina.data.titulo}</h1>
  <p class="subtitulo">{pagina.data.subtitulo}</p>

  <OpcoesDoSorteio />

  <section id="cartas" class="pilha-cartas bloco" aria-live="polite" aria-label="Peças sorteadas">
    {CARTAS.map(({ tipo, rotulo }) => <CartaSorteada tipo={tipo} rotulo={rotulo} />)}
    <div class="acoes">
      <button type="button" class="botao botao--principal" id="sortear">Gerar</button>
    </div>
  </section>

  <section class="bloco" aria-labelledby="ficha-titulo">
    <h2 id="ficha-titulo">A ficha</h2>
    {/* aria-live como na premissa: são quatro linhas curtas, relê-las a cada
        clique em Gerar é útil e não cansa. */}
    <p id="ficha" class="ficha__texto" aria-live="polite"></p>
    <div class="acoes">
      <button type="button" class="botao" id="copiar-ficha">Copiar ficha</button>
    </div>
    <span class="aviso" id="aviso-ficha" role="status"></span>
  </section>

  {/* O {' '} é necessário: o Astro descarta o espaço em branco entre o texto e a
      tag, e sem ele sai "soltas?Gere uma premissa". */}
  <p class="outro-modo">
    Prefere uma frase fechada, em vez das peças soltas?{' '}
    <a href={`${raiz}gerador/`}>Gere uma premissa</a>.
  </p>

  {/* is:inline porque isto é dado, não código: sem a diretiva o Astro trata o
      bloco como script a processar e emite um aviso em `npm run check`. */}
  <script type="application/json" id="pools" is:inline set:html={JSON.stringify(pools)}></script>
  <script type="application/json" id="modelo-ficha" is:inline set:html={JSON.stringify(pagina.body)}></script>
  <script type="application/json" id="nomes-dos-mundos" is:inline set:html={JSON.stringify(nomesDosMundos)}></script>
</Base>

<style>
  .subtitulo {
    margin: 0 0 24px;
    color: var(--texto);
    font-size: 1.05rem;
    max-width: 68ch;
  }

  /* pre-wrap porque as quebras de linha são o molde: a ficha é quatro linhas em
     três parágrafos, e sem elas viraria um bloco corrido que não é o que a
     autora escreveu em ficha.md. */
  .ficha__texto {
    margin: 0;
    min-height: 8em;
    white-space: pre-wrap;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--texto-forte);
  }

  .outro-modo {
    margin: 32px 0 0;
    text-align: center;
  }
</style>

<script>
  import { nomearMundosDe, redigirFicha, sortearFicha } from '../lib/gerador';
  import type { Opcoes, Pools, SorteioFicha, TravasFicha } from '../lib/gerador';

  const pools: Pools = JSON.parse(document.getElementById('pools')!.textContent!);
  const modelo: string = JSON.parse(document.getElementById('modelo-ficha')!.textContent!);
  const nomesDosMundos: Record<string, string> = JSON.parse(
    document.getElementById('nomes-dos-mundos')!.textContent!,
  );
  const form = document.getElementById('opcoes') as HTMLFormElement;
  const ficha = document.getElementById('ficha')!;

  const PECAS = ['personagemA', 'personagemB', 'cenario'] as const;

  const travas: TravasFicha = { personagemA: false, personagemB: false, cenario: false };

  // Como no gerador de premissas: o único estado vive em memória, nada é escrito
  // no navegador. Gerador efêmero, por decisão de projeto.
  let atual: SorteioFicha | null = null;

  const lerOpcoes = (): Opcoes => {
    const dados = new FormData(form);
    return {
      subgenero: String(dados.get('subgenero')),
      misturarMundos: dados.get('misturarMundos') === 'on',
      incluirComuns: dados.get('incluirComuns') === 'on',
    };
  };

  function pintar(sorteio: SorteioFicha, opcoes: Opcoes) {
    for (const tipo of PECAS) {
      const carta = document.querySelector(`[data-carta="${tipo}"]`)!;
      const peca = sorteio[tipo];
      carta.querySelector('[data-papel="nome"]')!.textContent = peca.nome;
      carta.querySelector('[data-papel="etiqueta"]')!.textContent = peca.subgenero.replace(/-/g, ' ');
    }
    // A ordem dos subgêneros é a das cartas na tela, e é ela que define como
    // "Cyberpunk + Distopia" sai escrito quando o sorteio mistura mundos.
    const mundo = nomearMundosDe(
      [sorteio.personagemA.subgenero, sorteio.personagemB.subgenero, sorteio.cenario.subgenero],
      opcoes,
      nomesDosMundos,
    );
    ficha.textContent = redigirFicha(modelo, sorteio, mundo);
  }

  function rolar() {
    const opcoes = lerOpcoes();
    atual = sortearFicha(pools, opcoes, travas, atual, Math.random);
    pintar(atual, opcoes);
  }

  document.getElementById('sortear')!.addEventListener('click', rolar);

  const aviso = document.getElementById('aviso-ficha')!;

  document.getElementById('copiar-ficha')!.addEventListener('click', async () => {
    const texto = ficha.textContent ?? '';
    if (!texto) return;
    try {
      await navigator.clipboard.writeText(texto);
      aviso.textContent = 'Ficha copiada.';
    } catch {
      aviso.textContent = 'Não foi possível copiar automaticamente.';
    }
    setTimeout(() => { aviso.textContent = ''; }, 2000);
  });

  for (const botao of document.querySelectorAll<HTMLButtonElement>('[data-travar]')) {
    botao.addEventListener('click', () => {
      const tipo = botao.dataset.travar as keyof TravasFicha;
      travas[tipo] = !travas[tipo];
      // aria-pressed é o estado inteiro: o CSS troca o cadeado aberto pelo
      // fechado a partir dele.
      botao.setAttribute('aria-pressed', String(travas[tipo]));
    });
  }

  // Trocar de opção zera o sorteio e as travas, pelo mesmo motivo do gerador de
  // premissas: uma peça travada do mundo antigo sobreviveria e contradiria a
  // opção recém-escolhida, e os cadeados continuariam fechados para peças que
  // não estão mais travadas.
  form.addEventListener('change', () => {
    atual = null;
    for (const tipo of PECAS) {
      travas[tipo] = false;
      document.querySelector<HTMLButtonElement>(`[data-travar="${tipo}"]`)!
        .setAttribute('aria-pressed', 'false');
    }
    rolar();
  });

  rolar();
</script>
