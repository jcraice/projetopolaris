---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cartao from '../../components/Cartao.astro';
import { paraAncora } from '../../lib/texto';

export async function getStaticPaths() {
  const subgeneros = await getCollection('subgeneros', (s) => s.data.mundo);
  return subgeneros.map((s) => ({ params: { subgenero: s.id }, props: { subgenero: s } }));
}

const { subgenero } = Astro.props;
const livros = (await getCollection('livros', (l) => l.data.subgenero === subgenero.id)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);
---
<Base titulo={`Livros ${subgenero.data.nome}`} aurora={subgenero.data.aurora}>
  <h1>Livros {subgenero.data.nome}</h1>
  {livros.map((l) => (
    <Cartao etiqueta={subgenero.data.nome} titulo={l.data.titulo} ancora={paraAncora(l.data.titulo)}>
      <p class="autor">{l.data.autor}</p>
      <p>{l.body}</p>
    </Cartao>
  ))}
  {subgenero.data.citacao && (
    <blockquote>{subgenero.data.citacao}<cite>{subgenero.data.citacaoAutor}</cite></blockquote>
  )}
</Base>

<style>
  .autor {
    font-weight: 800;
    color: var(--ouro);
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }

  blockquote {
    border-left: 3px solid var(--ouro);
    padding-left: 14px;
    margin-inline-start: 0;
    font-style: italic;
    color: var(--papel);
  }

  blockquote cite {
    display: block;
    margin-top: 6px;
    font-style: normal;
    color: var(--apagado);
  }
</style>
