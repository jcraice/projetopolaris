---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

const pagina = await getEntry('paginas', 'arquetipos');
if (!pagina) throw new Error("página 'arquetipos' não encontrada em src/content/paginas");
const { Content } = await render(pagina);

const subgeneros = (await getCollection('subgeneros')).sort((a, b) => a.data.ordem - b.data.ordem);

const base = import.meta.env.BASE_URL;
const raiz = base.endsWith('/') ? base : `${base}/`;
---
<Base titulo={pagina.data.titulo}>
  <h1>{pagina.data.titulo}</h1>
  <Content />
  <ul class="lista-subgeneros">
    {subgeneros.map((s) => (
      <li>
        <a href={`${raiz}arquetipos/${s.id}/`}>{s.data.nome}</a>
      </li>
    ))}
  </ul>
</Base>
