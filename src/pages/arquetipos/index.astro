---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PainelDePartidas from '../../components/PainelDePartidas.astro';
import CartaoDeEmbarque from '../../components/CartaoDeEmbarque.astro';
import { contagem } from '../../lib/texto';

const pagina = await getEntry('paginas', 'arquetipos');
if (!pagina) throw new Error("página 'arquetipos' não encontrada em src/content/paginas");
const { Content } = await render(pagina);

const comoUsar = await getEntry('paginas', 'arquetipos-como-usar');
if (!comoUsar) throw new Error("página 'arquetipos-como-usar' não encontrada em src/content/paginas");
if (!comoUsar.data.comoUsar) throw new Error("paginas/arquetipos-como-usar.md precisa dos passos em 'comoUsar'");

/* Sem filtro por `completo`: os 10 comuns entram no fim, marcados com uma
   estrela em vez de número. */
const subgeneros = (await getCollection('subgeneros')).sort((a, b) => a.data.ordem - b.data.ordem);
const verbetes = await getCollection('arquetipos');

const base = import.meta.env.BASE_URL;
const raiz = base.endsWith('/') ? base : `${base}/`;

/* As escalas do painel são os três primeiros verbetes de cada subgênero, pela
   ordem da autora — os mesmos que abrem a página do subgênero. */
const destinos = subgeneros.map((s) => ({
  nome: s.data.nome,
  href: `${raiz}arquetipos/${s.id}/`,
  escalas: verbetes
    .filter((v) => v.data.subgenero === s.id)
    .sort((a, b) => a.data.ordem - b.data.ordem)
    .slice(0, 3)
    .map((v) => v.data.nome),
  marca: s.data.completo ? undefined : '✦',
}));
---
<Base titulo="Arquétipos de ficção científica por subgênero" descricao={pagina.body ?? ''}>
  <p class="rotulo">Catálogo · {contagem(subgeneros.filter((s) => s.data.completo).length, 'subgênero', 'subgêneros')}</p>
  <h1>{pagina.data.titulo}</h1>
  <Content />
  <PainelDePartidas destinos={destinos} />
  <CartaoDeEmbarque titulo={comoUsar.data.titulo} catalogo={pagina.data.titulo} passos={comoUsar.data.comoUsar} />
</Base>
