---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cartao from '../../components/Cartao.astro';
import TrocarDeSubgenero from '../../components/TrocarDeSubgenero.astro';
import { ilustracaoDe } from '../../lib/ilustracoes';
import { contagem, numeracao, paraAncora } from '../../lib/texto';

export async function getStaticPaths() {
  const subgeneros = await getCollection('subgeneros');
  return subgeneros.map((s) => ({ params: { subgenero: s.id }, props: { subgenero: s } }));
}

const { subgenero } = Astro.props;
const fichas = (await getCollection('arquetipos', (a) => a.data.subgenero === subgenero.id))
  .sort((a, b) => a.data.ordem - b.data.ordem);
const comuns = fichas.filter((f) => !f.data.felino);
const felino = fichas.find((f) => f.data.felino);
---
<Base titulo={`Arquétipos ${subgenero.data.nome}`}>
  <p class="rotulo">{subgenero.data.nome} · {contagem(fichas.length, 'arquétipo', 'arquétipos')}</p>
  <h1>Arquétipos {subgenero.data.nome}</h1>
  {subgenero.data.aberturaArquetipos && <p class="abertura">{subgenero.data.aberturaArquetipos}</p>}
  <div class="lista-verbetes">
    {comuns.map((f, i) => (
      <Cartao numero={numeracao(i + 1, fichas.length)} titulo={f.data.nome} ancora={paraAncora(f.data.nome)}>
        <p>{f.body}</p>
      </Cartao>
    ))}
    {felino && (
      <section aria-label="Arquétipo felino">
        <Cartao
          numero={numeracao(fichas.length, fichas.length)}
          marcador="Arquétipo Felino"
          titulo={felino.data.nome}
          ancora={paraAncora(felino.data.nome)}
          ilustracao={ilustracaoDe(felino.data)}
        >
          <p>{felino.body}</p>
        </Cartao>
      </section>
    )}
  </div>
  {subgenero.data.citacao && (
    <blockquote>{subgenero.data.citacao}<cite>{subgenero.data.citacaoAutor}</cite></blockquote>
  )}
  <TrocarDeSubgenero tipo="arquetipos" atual={subgenero.id} />
</Base>
