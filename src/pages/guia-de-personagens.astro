---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { PROFISSOES } from '../lib/gerador';
import { contagem } from '../lib/texto';

/* Guia do gerador, não um quinto catálogo. Por isso a página não entra no Nav,
   não tem rota por subgênero e não aparece na busca — o índice da busca é montado a
   partir das quatro coleções de src/content/, e as profissões não são coleção,
   então não há nada a excluir. O único caminho até aqui é o link no fim de
   gerador.astro. Uma página fora do menu parece esquecimento; é decisão. */
const subgeneros = (await getCollection('subgeneros', (s) => s.data.completo))
  .sort((a, b) => a.data.ordem - b.data.ordem);

const base = import.meta.env.BASE_URL;
const raiz = base.endsWith('/') ? base : base + '/';
---
<Base titulo="Guia de personagens">
  <p class="rotulo">Gerador · {contagem(PROFISSOES.length, 'profissão', 'profissões')}</p>
  <h1>Guia de personagens</h1>

  <p class="abertura">
    As profissões que o gerador sorteia, com o que cada uma é. São dez por subgênero,
    e o subgênero escolhido no gerador decide de quais dez os dois personagens saem.
  </p>

  {/* Mesmo padrão do sumário de /subgeneros/[subgenero]/: são cem termos em dez
      blocos, e sem os atalhos chegar ao último é rolar a página inteira. */}
  <nav class="sumario" aria-label="Sumário do guia">
    {subgeneros.map((subgenero) => (
      <a href={`#${subgenero.id}`}>{subgenero.data.nome}</a>
    ))}
  </nav>

  {subgeneros.map((subgenero) => (
    <section class="bloco" id={subgenero.id}>
      <h2>{subgenero.data.nome}</h2>
      <dl class="profissoes">
        {PROFISSOES.filter((p) => p.subgenero === subgenero.id).map((profissao) => (
          <div class="profissao">
            <dt>{profissao.nome}</dt>
            <dd>{profissao.descricao}</dd>
          </div>
        ))}
      </dl>
    </section>
  ))}

  <p class="volta"><a href={`${raiz}gerador/`}>Voltar ao gerador</a></p>
</Base>

<style>
  /* <dl> porque é exatamente isto: uma lista de termos e suas definições. O
     <div> em volta de cada par existe para o grid tratar o par como uma unidade
     — sem ele, dt e dd viram itens soltos e desalinham. */
  /* Duas colunas: cada profissão é um nome e uma linha, e em coluna única elas
     ocupavam um terço da largura e deixavam o resto vazio, com as cem
     empilhadas descendo sem fim. `auto-fit` com mínimo de 320px devolve a
     coluna única no celular sem precisar de consulta de mídia. */
  .profissoes {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px 40px;
  }

  /* Os mesmos 96px do scroll-margin-top do Cartão e das seções de
     /subgeneros/[subgenero]/: sem isto o título do bloco para debaixo da barra
     fixa quando o sumário salta para ele. */
  .bloco {
    scroll-margin-top: 96px;
  }

  .sumario {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-block: 20px 32px;
  }

  .sumario a {
    color: var(--texto);
    text-decoration: none;
    font-family: var(--fonte-rotulo);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.78rem;
    border-bottom: 1px solid var(--apoio);
    padding-bottom: 2px;
  }

  .profissao {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* O nome do subgênero em acento, por escolha da autora: são dez seções seguidas,
     todas do mesmo fundo, e sem cor o h2 ficava igual aos cem termos
     abaixo dele. Contraste sobre --bloco: 5,68:1 no escuro e 4,56:1 no claro
     (docs/verificacao-visual.md) — passa até no critério de texto pequeno.
     Continua laranja na Carta Estelar, que guarda o acento para poucas peças,
     porque foi pedido dela para esta página. */
  h2 {
    color: var(--destaque);
  }

  /* Mesmo peso e cor do título de verbete do catálogo: quem separa um termo do
     seguinte é o espaço, não moldura nem cor de acento. */
  dt {
    font-family: var(--fonte-titulo);
    font-weight: 500;
    font-size: 1.2rem;
    color: var(--texto-forte);
  }

  dd {
    margin: 0;
    color: var(--texto);
  }

  .volta {
    margin-top: 32px;
  }
</style>
