---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cartao from '../../components/Cartao.astro';
import TrocarDeMundo from '../../components/TrocarDeMundo.astro';
import { ilustracaoDe } from '../../lib/ilustracoes';
import { paraAncora } from '../../lib/texto';

export async function getStaticPaths() {
  const subgeneros = await getCollection('subgeneros', (s) => s.data.mundo);
  return subgeneros.map((s) => ({ params: { subgenero: s.id }, props: { subgenero: s } }));
}

const { subgenero } = Astro.props;
const elementos = (await getCollection('elementos', (e) => e.data.subgenero === subgenero.id)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);
---
<Base titulo={`Elementos ${subgenero.data.nome}`} aurora={subgenero.data.aurora}>
  <h1>Elementos {subgenero.data.nome}</h1>
  {/* Aqui morava `subgenero.body`, a descrição geral do mundo — a mesma que
      abre /mundos/. Saiu quando a autora escreveu uma abertura própria para
      cada tipo: esta fala dos elementos que estão na lista abaixo, e não do
      mundo em volta, como já acontecia em /arquetipos/. */}
  {subgenero.data.aberturaElementos && <p class="abertura">{subgenero.data.aberturaElementos}</p>}
  <div class="bloco">
    {elementos.map((e) => (
      <Cartao titulo={e.data.titulo} ancora={paraAncora(e.data.titulo)} ilustracao={ilustracaoDe(e.data)}>
        <p>{e.body}</p>
      </Cartao>
    ))}
  </div>
  {subgenero.data.citacao && (
    <blockquote>{subgenero.data.citacao}<cite>{subgenero.data.citacaoAutor}</cite></blockquote>
  )}
  <TrocarDeMundo tipo="elementos" atual={subgenero.id} />
</Base>
