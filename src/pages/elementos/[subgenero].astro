---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cartao from '../../components/Cartao.astro';
import TrocarDeSubgenero from '../../components/TrocarDeSubgenero.astro';
import { ilustracaoDe } from '../../lib/ilustracoes';
import { contagem, numeracao, paraAncora } from '../../lib/texto';

export async function getStaticPaths() {
  const subgeneros = await getCollection('subgeneros', (s) => s.data.completo);
  return subgeneros.map((s) => ({ params: { subgenero: s.id }, props: { subgenero: s } }));
}

const { subgenero } = Astro.props;
const elementos = (await getCollection('elementos', (e) => e.data.subgenero === subgenero.id)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);
---
<Base titulo={`Elementos ${subgenero.data.nome}`}>
  <p class="rotulo">{subgenero.data.nome} · {contagem(elementos.length, 'elemento', 'elementos')}</p>
  <h1>Elementos {subgenero.data.nome}</h1>
  {/* Aqui morava `subgenero.body`, a descrição geral do subgênero — a mesma que
      abre /subgeneros/. Saiu quando a autora escreveu uma abertura própria para
      cada tipo: esta fala dos elementos que estão na lista abaixo, e não do
      subgênero em volta, como já acontecia em /arquetipos/. */}
  {subgenero.data.aberturaElementos && <p class="abertura">{subgenero.data.aberturaElementos}</p>}
  <div class="lista-verbetes">
    {elementos.map((e, i) => (
      <Cartao numero={numeracao(i + 1, elementos.length)} titulo={e.data.titulo} ancora={paraAncora(e.data.titulo)} ilustracao={ilustracaoDe(e.data)}>
        <p>{e.body}</p>
      </Cartao>
    ))}
  </div>
  <TrocarDeSubgenero tipo="elementos" atual={subgenero.id} />
</Base>
