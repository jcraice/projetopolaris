---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const pagina = await getEntry('paginas', 'estilos');
if (!pagina) throw new Error("página 'estilos' não encontrada em src/content/paginas");
const { Content } = await render(pagina);
---
<Base titulo={pagina.data.titulo}>
  <h1>{pagina.data.titulo}</h1>
  <div class="conteudo">
    <Content />
  </div>
</Base>

<style>
  /* O HTML vem de render() do Markdown e não recebe o atributo de escopo do
     Astro, então o alcance tem que ser dado pelo contêiner: a classe .conteudo
     é escopada, e :global() alcança o que está dentro dela. */
  .conteudo :global(h2) {
    color: var(--destaque);
  }

  .conteudo :global(p) {
    max-width: 68ch;
    line-height: 1.55;
  }
</style>
