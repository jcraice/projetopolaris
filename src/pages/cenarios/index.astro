---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

const pagina = await getEntry('paginas', 'cenarios');
const { Content } = await render(pagina);

const subgeneros = (await getCollection('subgeneros', (s) => s.data.mundo)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);

const base = import.meta.env.BASE_URL;
const raiz = base.endsWith('/') ? base : `${base}/`;
---
<Base titulo={pagina.data.titulo}>
  <h1>{pagina.data.titulo}</h1>
  <Content />
  <ul class="lista-subgeneros">
    {subgeneros.map((s) => (
      <li>
        <a href={`${raiz}cenarios/${s.id}/`}>{s.data.nome}</a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .lista-subgeneros {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    list-style: none;
    padding: 0;
  }

  .lista-subgeneros a {
    display: inline-block;
    border: 2px solid var(--violeta);
    padding: 8px 14px;
    font-weight: 800;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--texto);
  }

  .lista-subgeneros a:hover {
    color: var(--ouro);
    border-color: var(--ouro);
  }
</style>
