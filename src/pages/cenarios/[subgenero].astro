---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cartao from '../../components/Cartao.astro';
import TrocarDeMundo from '../../components/TrocarDeMundo.astro';
import { ilustracaoDe } from '../../lib/ilustracoes';
import { paraAncora } from '../../lib/texto';

export async function getStaticPaths() {
  const subgeneros = await getCollection('subgeneros', (s) => s.data.mundo);
  return subgeneros.map((s) => ({ params: { subgenero: s.id }, props: { subgenero: s } }));
}

const { subgenero } = Astro.props;
const cenarios = (await getCollection('cenarios', (c) => c.data.subgenero === subgenero.id)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);
---
<Base titulo={`Cenários ${subgenero.data.nome}`} aurora={subgenero.data.aurora}>
  <h1>Cenários {subgenero.data.nome}</h1>
  {subgenero.data.aberturaCenarios && <p class="abertura">{subgenero.data.aberturaCenarios}</p>}
  <div class="bloco">
    {cenarios.map((c) => (
      <Cartao titulo={c.data.titulo} ancora={paraAncora(c.data.titulo)} ilustracao={ilustracaoDe(c.data)}>
        <p>{c.body}</p>
      </Cartao>
    ))}
  </div>
  {subgenero.data.citacao && (
    <blockquote>{subgenero.data.citacao}<cite>{subgenero.data.citacaoAutor}</cite></blockquote>
  )}
  <TrocarDeMundo tipo="cenarios" atual={subgenero.id} />
</Base>
