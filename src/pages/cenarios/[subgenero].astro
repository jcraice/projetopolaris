---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cartao from '../../components/Cartao.astro';
import TrocarDeSubgenero from '../../components/TrocarDeSubgenero.astro';
import { ilustracaoDe } from '../../lib/ilustracoes';
import { contagem, numeracao, paraAncora } from '../../lib/texto';

export async function getStaticPaths() {
  const subgeneros = await getCollection('subgeneros', (s) => s.data.completo);
  return subgeneros.map((s) => ({ params: { subgenero: s.id }, props: { subgenero: s } }));
}

const { subgenero } = Astro.props;
const cenarios = (await getCollection('cenarios', (c) => c.data.subgenero === subgenero.id)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);
---
<Base titulo={`Cenários de ${subgenero.data.nome} na ficção científica`} descricao={subgenero.data.aberturaCenarios ?? subgenero.body ?? ''}>
  <p class="rotulo">{subgenero.data.nome} · {contagem(cenarios.length, 'cenário', 'cenários')}</p>
  <h1>Cenários {subgenero.data.nome}</h1>
  {subgenero.data.aberturaCenarios && <p class="abertura">{subgenero.data.aberturaCenarios}</p>}
  <div class="lista-verbetes">
    {cenarios.map((c, i) => (
      <Cartao numero={numeracao(i + 1, cenarios.length)} titulo={c.data.titulo} ancora={paraAncora(c.data.titulo)} ilustracao={ilustracaoDe(c.data)}>
        <p>{c.body}</p>
      </Cartao>
    ))}
  </div>
  <TrocarDeSubgenero tipo="cenarios" atual={subgenero.id} />
</Base>
