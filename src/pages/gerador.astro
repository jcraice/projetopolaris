---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { montarPrompt } from '../lib/gerador';

const subgeneros = await getCollection('subgeneros');
const mundos = subgeneros.filter((s) => s.data.mundo).sort((a, b) => a.data.ordem - b.data.ordem);

// O texto do prompt é conteúdo da autora, não código: mora em Markdown e é lido
// como texto cru (`body`), nunca renderizado — o que a IA recebe é o que está
// escrito lá.
const modeloDoPrompt = await getEntry('paginas', 'prompt-ia');
if (!modeloDoPrompt) throw new Error("página 'prompt-ia' não encontrada em src/content/paginas");
if (!modeloDoPrompt.body) throw new Error("página 'prompt-ia' está sem corpo em src/content/paginas");

// O montarPrompt estoura em marcador desconhecido, e é aqui que isso vira
// utilidade: uma chamada em tempo de build faz um `[PERSONAGEM Á]` com acento
// errado quebrar `npm run build` — o mesmo portão que o deploy roda — em vez de
// chegar em produção e deixar o card do prompt vazio em silêncio.
// Os valores são de descarte: quem importa aqui são os marcadores do modelo.
montarPrompt(modeloDoPrompt.body, {
  mundo: 'conferência',
  personagemA: 'conferência',
  personagemB: 'conferência',
  local: 'conferência',
  fato: 'conferência',
});

// Mapa de identificador para nome de exibição, para o prompt dizer "Space Opera"
// e não "space-opera". Só os mundos entram; `comuns` não é mundo e nomearMundos
// o ignora.
const nomesDosMundos = Object.fromEntries(mundos.map((m) => [m.id, m.data.nome]));

// Só os locais vêm daqui: são os 60 cenários do acervo, lidos em build e
// injetados como JSON estático. As profissões, características, personalidades
// e fatos moram em src/lib/gerador/ e o <script> os importa direto — não
// precisam passar pelo HTML.
const locais = (await getCollection('cenarios')).map((c) => ({
  id: c.id, nome: c.data.titulo, subgenero: c.data.subgenero, singular: c.data.singular,
}));

const base = import.meta.env.BASE_URL;
const raiz = base.endsWith('/') ? base : base + '/';
---
<Base titulo="Gerador">
  <h1>Gerador de combinações</h1>

  <form id="opcoes">
    <fieldset>
      <legend>Opções do sorteio</legend>
      <label for="opcoes-mundo">
        Mundo
        <select id="opcoes-mundo" name="subgenero">
          {mundos.map((m) => <option value={m.id}>{m.data.nome}</option>)}
        </select>
      </label>
      <label><input type="checkbox" name="misturarMundos" /> Misturar mundos</label>
    </fieldset>
  </form>

  {/* A premissa é a interface do gerador: não existe mais uma pilha de cartas
      repetindo, acima dela, o que a frase já diz. O que o sorteio trouxe aparece
      em --destaque dentro do próprio texto, e o cadeado de cada linha trava
      aquela peça.

      O conteúdo é montado pelo <script> a partir de partes(): sem JavaScript o
      bloco fica vazio, como já ficava antes. */}
  {/* Sem título visível, por decisão da autora: o bloco é a premissa, e um
      "Premissa gerada" em cima dela só repetia em palavras o que a frase já
      mostra. O nome sobrevive em aria-label — apagar o <h2> tirava também o
      rótulo que o leitor de tela usa para anunciar a região, e aí o bloco
      chegaria como uma seção sem nome. */}
  <section class="bloco bloco-premissa" aria-label="Premissa gerada">
    {/* aria-live no parágrafo, e não na seção inteira: na seção, cada clique
        em Gerar faria o leitor de tela reler também o rótulo. Os quatro cadeados
        moram dentro da região viva, e o custo é que a releitura pode incluir os
        rótulos deles — aceito em vez de duplicar a premissa num parágrafo
        escondido (dois textos que podem divergir) ou de tirar o aria-live e
        deixar quem não enxerga sem saber que a premissa mudou. */}
    <p id="premissa" class="premissa" aria-live="polite"></p>
  </section>
  <div class="acoes">
    <button type="button" class="botao botao--principal" id="sortear">Gerar</button>
    <button type="button" class="botao" id="copiar-premissa">Copiar premissa</button>
    <span class="aviso" id="aviso-premissa" role="status"></span>
  </div>

  {/* O botão vive aqui, num <template>, e não numa string dentro do script: o
      SVG continua sendo marcação legível, e o script só clona. O rótulo fica no
      aria-label e não muda com o estado — aria-pressed já faz o leitor de tela
      anunciar "pressionado"/"não pressionado", e um rótulo que também virasse
      "Destravar" diria a mesma coisa duas vezes, uma delas invertida. */}
  <template id="modelo-cadeado">
    <button type="button" class="cadeado" aria-pressed="false">
      <svg class="cadeado__aberto" viewBox="0 0 24 24" width="16" height="16"
           fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="4" y="11" width="16" height="10" rx="2" />
        <path d="M8 11V7a4 4 0 0 1 7.5-2" />
      </svg>
      <svg class="cadeado__fechado" viewBox="0 0 24 24" width="16" height="16"
           fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="4" y="11" width="16" height="10" rx="2" />
        <path d="M8 11V7a4 4 0 0 1 8 0v4" />
      </svg>
    </button>
  </template>

  <section class="bloco bloco-prompt" aria-labelledby="prompt-titulo">
    <h2 id="prompt-titulo">Crie enredos com sua IA favorita</h2>
    {/* Sem aria-live, ao contrário da premissa: é um bloco de várias linhas que
        repete as peças já anunciadas acima, e relê-lo a cada clique em Gerar
        tornaria a página impraticável com leitor de tela. Quem quiser o texto
        chega nele navegando. */}
    <p id="prompt" class="prompt__texto"></p>
  </section>
  <div class="acoes">
    <button type="button" class="botao" id="copiar-prompt">Copiar prompt</button>
    <span class="aviso" id="aviso-prompt" role="status"></span>
  </div>

  {/* Único caminho até o guia: ele não está no Nav nem na busca, por decisão de
      projeto — é material de apoio do gerador, não um catálogo do site. */}
  <p class="guia">
    Não conhece alguma das profissões? <a href={`${raiz}guia-de-personagens/`}>Veja o guia de personagens</a>.
  </p>

  {/* is:inline porque isto é dado, não código: sem a diretiva o Astro trata o
      bloco como script a processar e emite um aviso em `npm run check`. */}
  <script type="application/json" id="locais" is:inline set:html={JSON.stringify(locais)}></script>
  <script type="application/json" id="modelo-prompt" is:inline set:html={JSON.stringify(modeloDoPrompt.body)}></script>
  <script type="application/json" id="nomes-dos-mundos" is:inline set:html={JSON.stringify(nomesDosMundos)}></script>
</Base>

<style>
  fieldset {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    border: 2px solid var(--borda-suave);
    padding: 14px 18px;
    margin: 0 0 24px;
  }

  legend {
    padding: 0 6px;
    font-weight: 900;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--apagado);
  }

  #opcoes label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }

  #opcoes select {
    background: var(--fundo);
    color: var(--texto);
    border: 2px solid var(--borda-suave);
    padding: 6px 10px;
    font-family: inherit;
    /* 1rem pelo mesmo motivo do campo de busca: abaixo de 16px o Safari do
       iPhone amplia a página ao abrir o seletor. */
    font-size: 1rem;
    border-radius: var(--raio);
  }

  #opcoes select:focus-visible,
  #opcoes input:focus-visible {
    outline: 3px solid var(--apoio);
    outline-offset: 3px;
  }

  /* O cadeado vive dentro do texto da premissa, no fim da linha que trava.
     inline-flex para acompanhar a linha; vertical-align porque, solto na linha
     de base, o ícone desce e desalinha em relação às letras. */
  .cadeado {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: -0.2em;
    /* 28px de área tocável, acima dos 24px do WCAG 2.2 AA, com um ícone de 16px
       dentro. Era 36/20 enquanto o cadeado morava no canto de uma carta;
       encolheu ao vir para o meio do texto, e a autora pediu que fosse sutil. */
    width: 28px;
    height: 28px;
    /* Cola o cadeado na linha que ele trava, e o afasta do ponto final. */
    margin-inline-start: 6px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    /* --texto, e não --apagado: o cadeado é elemento de interface e precisa de
       3:1 sobre o fundo. Direto sobre o céu o apagado fica em 2,1 no pior
       mundo, e --destaque, do estado travado, em 4,3. */
    color: var(--texto);
    transition: color 0.15s ease;
    border-radius: var(--raio);
  }

  .cadeado:hover,
  .cadeado[aria-pressed='true'] {
    color: var(--destaque);
  }

  .cadeado:focus-visible {
    outline: 3px solid var(--apoio);
    outline-offset: 2px;
  }

  /* O par de ícones vive no HTML e quem troca é o CSS, a partir do
     aria-pressed que o script já mantinha. Assim o estado visual e o estado
     anunciado pelo leitor de tela não têm como divergir. */
  .cadeado__fechado {
    display: none;
  }

  .cadeado[aria-pressed='true'] .cadeado__aberto {
    display: none;
  }

  .cadeado[aria-pressed='true'] .cadeado__fechado {
    display: block;
  }

  /* pre-wrap porque a premissa é um bloco de linhas, não um parágrafo corrido:
     as quebras vêm do MOLDE e precisam aparecer na tela. Mesmo motivo do
     .prompt__texto logo abaixo.

     line-height maior que a do prompt porque agora há cadeados de 28px no meio
     das linhas: com o espaçamento apertado, o ícone de uma linha encostava no
     texto da seguinte. */
  .premissa {
    margin: 0;
    min-height: 1.6em;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--texto-forte);
    white-space: pre-wrap;
  }

  /* O que o sorteio trouxe, destacado dentro da própria frase — é isto que
     tomou o lugar da pilha de cartas que ficava acima da premissa repetindo o
     que ela já dizia. --destaque nos dois temas: o amarelo no escuro e o laranja
     no claro. Sobre o fundo do bloco dá 6,78:1 no pior mundo escuro e 4,59:1 no
     claro; acima dos 4,5:1 que texto comum exige, com folga pequena no claro —
     mais um motivo para o --destaque do tema claro não poder clarear.

     `:global()` porque estes spans nascem do JavaScript, em montarPremissa(), e
     por isso não recebem o atributo de escopo que o Astro põe na marcação
     escrita no arquivo. Sem ele a regra é descartada em silêncio e o amarelo
     simplesmente não aparece — o mesmo cuidado que o HTML vindo de render()
     exige. O `.premissa` na frente mantém o escopo: quem é global é só o filho. */
  .premissa :global(.sorteado) {
    color: var(--destaque);
    font-weight: 700;
  }

  /* O título do bloco do prompt em acento, por escolha da autora — é o único
     título de seção da página, e sem cor ele se perdia entre a premissa acima e
     o texto do prompt logo abaixo. Sobre --bloco o acento mede 6,78:1 no escuro
     e 4,59:1 no claro (docs/verificacao-visual.md): passa até no critério de
     texto pequeno, e este h2 tem 24px. */
  .bloco-prompt h2 {
    color: var(--destaque);
  }

  /* pre-wrap, e não <pre>: as quebras de linha do prompt-ia.md fazem parte do
     texto que vai para a IA — é o que põe cada uma das quatro peças na própria
     linha, a forma que aguenta título começado por artigo ("A busca por
     autenticidade") — e precisam aparecer na tela igual. Mas isto é texto para
     ler, não código: nada de fonte monoespaçada nem moldura. */
  .prompt__texto {
    margin: 0;
    white-space: pre-wrap;
    line-height: 1.5;
  }

  /* O botão de cada bloco fica fora da caixa cinza, logo abaixo dela, e não
     dentro do rodapé como antes: a caixa guarda só o que foi sorteado ou
     escrito, e a ação que opera sobre aquilo mora do lado de fora. Cada botão
     continua encostado no bloco a que pertence — três caixas, três ações —, e é
     ele que agora separa uma caixa da seguinte, que de outro modo se
     encostariam por terem o mesmo fundo. Em coluna porque o aviso de "copiado"
     vem junto, logo abaixo do próprio botão. */
  .acoes {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin: 16px 0 32px;
  }

  /* Um aviso por botão de copiar, logo abaixo dele: a confirmação aparece onde
     a pessoa clicou, e não num canto distante da página. O min-height reserva a
     linha desde o começo — sem ele, a página inteira pula para baixo quando a
     mensagem aparece. */
  .aviso {
    min-height: 1.2em;
    text-align: center;
    color: var(--apagado);
    font-size: 0.85rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .cadeado {
      transition: none;
    }
  }
</style>

<script>
  import { montarPrompt, nomearMundos, partes, sortear, redigir, MOLDE, PROFISSOES } from '../lib/gerador';
  import type { Opcoes, PecaCenario, Pools, Sorteio, Travas } from '../lib/gerador';

  const locais: PecaCenario[] = JSON.parse(document.getElementById('locais')!.textContent!);
  const modeloDoPrompt: string = JSON.parse(document.getElementById('modelo-prompt')!.textContent!);
  const nomesDosMundos: Record<string, string> = JSON.parse(
    document.getElementById('nomes-dos-mundos')!.textContent!,
  );

  // As profissões vêm do módulo, os locais do JSON injetado: os dois se juntam
  // aqui para sortear() continuar recebendo tudo por parâmetro e seguir puro.
  const pools: Pools = { profissoes: PROFISSOES, locais };

  const form = document.getElementById('opcoes') as HTMLFormElement;
  const premissa = document.getElementById('premissa')!;
  const prompt = document.getElementById('prompt')!;

  const travas: Travas = { personagemA: false, personagemB: false, local: false, fato: false };

  // Único estado guardado do gerador, e vive só em memória: nada é escrito no
  // navegador (sem localStorage, sem conta, sem link compartilhável), por
  // decisão de projeto de gerador efêmero.
  let atual: Sorteio | null = null;

  const lerOpcoes = (): Opcoes => {
    const dados = new FormData(form);
    return {
      subgenero: String(dados.get('subgenero')),
      misturarMundos: dados.get('misturarMundos') === 'on',
    };
  };

  /* A estrutura da premissa é montada uma vez, no carregamento, e não a cada
     rolagem: o MOLDE é fixo, então os spans e os cadeados estão sempre nos
     mesmos lugares e só o texto dos sorteados muda. Reconstruir tudo a cada
     "Gerar" tiraria o foco do teclado de quem está navegando pelos cadeados e
     obrigaria a religar os ouvintes de clique.

     Guarda os spans sorteados na ordem em que aparecem; pintar() os percorre na
     mesma ordem que partes() devolve. */
  const sorteados: HTMLElement[] = [];

  const ROTULO: Record<keyof Travas, string> = {
    personagemA: 'personagem A',
    personagemB: 'personagem B',
    local: 'local',
    fato: 'fato',
  };

  function montarPremissa(sorteio: Sorteio, mundo: string) {
    const modeloCadeado = document.getElementById('modelo-cadeado') as HTMLTemplateElement;

    for (const linha of partes(sorteio, MOLDE, mundo)) {
      for (const trecho of linha.trechos) {
        const span = document.createElement('span');
        span.textContent = trecho.texto;
        // O texto fixo do molde é escrito aqui e nunca mais: só os sorteados
        // entram na lista que pintar() reescreve a cada rolagem.
        if (trecho.sorteado) {
          span.className = 'sorteado';
          sorteados.push(span);
        }
        premissa.append(span);
      }

      if (linha.trava) {
        const botao = modeloCadeado.content.firstElementChild!.cloneNode(true) as HTMLButtonElement;
        botao.dataset.travar = linha.trava;
        botao.setAttribute('aria-label', `Travar ${ROTULO[linha.trava]}`);
        premissa.append(botao);
      }

      // A quebra é um nó de texto de verdade, e não uma margem: o contêiner é
      // pre-wrap, e é ela que reproduz o MOLDE linha por linha.
      premissa.append('\n');
    }

    // O MOLDE não termina em quebra; a do último laço sobra.
    premissa.lastChild?.remove();
  }

  function pintar(sorteio: Sorteio, opcoes: Opcoes) {
    const mundo = nomearMundos(sorteio, opcoes, nomesDosMundos);

    if (sorteados.length === 0) montarPremissa(sorteio, mundo);

    const valores = partes(sorteio, MOLDE, mundo)
      .flatMap((linha) => linha.trechos)
      .filter((trecho) => trecho.sorteado);
    valores.forEach((trecho, i) => { sorteados[i].textContent = trecho.texto; });

    prompt.textContent = montarPrompt(modeloDoPrompt, {
      mundo,
      // O "Um(a)" vem escrito aqui e no MOLDE, e não da lista, porque as 60
      // profissões abrem com o mesmo artigo — ver o comentário em moldes.ts.
      personagemA: `Um(a) ${sorteio.personagemA.profissao.nome} que ${sorteio.personagemA.caracteristica}`,
      personagemB: `Um(a) ${sorteio.personagemB.profissao.nome} que é ${sorteio.personagemB.personalidade}`,
      local: sorteio.local.nome,
      fato: sorteio.fato,
    });
  }

  function rolar() {
    const opcoes = lerOpcoes();
    atual = sortear(pools, opcoes, travas, atual, Math.random);
    pintar(atual, opcoes);
  }

  document.getElementById('sortear')!.addEventListener('click', rolar);

  /* A mensagem de sucesso vem pronta em vez de ser montada com o nome da peça:
     "premissa" é feminino e "prompt" é masculino, e montar a frase aqui daria
     "Prompt copiada". */
  async function copiar(texto: string, aviso: HTMLElement, sucesso: string) {
    if (!texto) return;
    try {
      await navigator.clipboard.writeText(texto);
      aviso.textContent = sucesso;
    } catch {
      aviso.textContent = 'Não foi possível copiar automaticamente.';
    }
    setTimeout(() => { aviso.textContent = ''; }, 2000);
  }

  const avisoDaPremissa = document.getElementById('aviso-premissa')!;
  const avisoDoPrompt = document.getElementById('aviso-prompt')!;

  /* Copia redigir(), e não o textContent do contêiner: os cadeados não somam
     texto, mas depender disso seria frágil, e redigir() é a mesma junção de
     partes() que desenhou a tela. */
  document.getElementById('copiar-premissa')!.addEventListener('click', () => {
    const opcoes = lerOpcoes();
    const texto = atual ? redigir(atual, MOLDE, nomearMundos(atual, opcoes, nomesDosMundos)) : '';
    copiar(texto, avisoDaPremissa, 'Premissa copiada.');
  });

  document.getElementById('copiar-prompt')!.addEventListener('click', () => {
    copiar(prompt.textContent ?? '', avisoDoPrompt, 'Prompt copiado.');
  });

  /* Um ouvinte no contêiner, e não um por botão: os cadeados só existem depois
     que montarPremissa() roda, e um laço sobre [data-travar] aqui não acharia
     nada — este script executa antes da primeira rolagem. */
  premissa.addEventListener('click', (evento) => {
    const botao = (evento.target as HTMLElement).closest<HTMLButtonElement>('[data-travar]');
    if (!botao) return;

    const tipo = botao.dataset.travar as keyof Travas;
    travas[tipo] = !travas[tipo];
    // aria-pressed é o estado inteiro: o CSS troca o cadeado aberto pelo
    // fechado a partir dele. Nada de mexer no conteúdo do botão aqui —
    // escrever textContent apagaria os dois SVGs de dentro dele.
    botao.setAttribute('aria-pressed', String(travas[tipo]));
  });

  // Trocar de mundo (ou qualquer opção do formulário) zera o sorteio anterior:
  // sem isto, uma peça travada do mundo antigo sobreviveria e contradiria a
  // opção recém-escolhida. As travas também zeram aqui — sortear() já as ignora
  // sem `anterior`, mas sem este trecho os cadeados continuariam fechados, com
  // aria-pressed="true", para peças que não estão mais travadas.
  form.addEventListener('change', () => {
    atual = null;
    for (const tipo of Object.keys(travas) as (keyof Travas)[]) travas[tipo] = false;
    for (const botao of premissa.querySelectorAll('[data-travar]')) {
      botao.setAttribute('aria-pressed', 'false');
    }
    rolar();
  });

  rolar();
</script>
