---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import CartaSorteada from '../components/CartaSorteada.astro';
import OpcoesDoSorteio from '../components/OpcoesDoSorteio.astro';
import { montarPrompt } from '../lib/gerador';

const subgeneros = await getCollection('subgeneros');
const mundos = subgeneros.filter((s) => s.data.mundo).sort((a, b) => a.data.ordem - b.data.ordem);

// O texto do prompt é conteúdo da autora, não código: mora em Markdown e é lido
// como texto cru (`body`), nunca renderizado — o que a IA recebe é o que está
// escrito lá.
const modeloDoPrompt = await getEntry('paginas', 'prompt-ia');
if (!modeloDoPrompt) throw new Error("página 'prompt-ia' não encontrada em src/content/paginas");
if (!modeloDoPrompt.body) throw new Error("página 'prompt-ia' está sem corpo em src/content/paginas");

// O montarPrompt estoura em marcador desconhecido, e é aqui que isso vira
// utilidade: uma chamada em tempo de build faz um `[ARQUETIPO]` sem acento no
// prompt-ia.md quebrar `npm run build` — o mesmo portão que o deploy roda —
// em vez de chegar em produção e deixar o card do prompt vazio em silêncio.
// Os valores são de descarte: quem importa aqui são os marcadores do modelo.
montarPrompt(modeloDoPrompt.body, {
  mundo: 'conferência',
  arquetipo: 'conferência',
  cenario: 'conferência',
  elemento: 'conferência',
});

// Mapa de identificador para nome de exibição, para o prompt dizer "Space Opera"
// e não "space-opera". Só os mundos entram; `comuns` não é mundo e nomearMundos
// o ignora.
const nomesDosMundos = Object.fromEntries(mundos.map((m) => [m.id, m.data.nome]));

const base = import.meta.env.BASE_URL;
const raiz = base.endsWith('/') ? base : `${base}/`;

// Os pools inteiros (146 arquétipos, 60 cenários, 120 elementos) são lidos
// aqui em build e injetados como JSON estático na página — a interatividade
// do gerador não faz nenhuma requisição em tempo de execução.
const pools = {
  arquetipos: (await getCollection('arquetipos')).map((a) => ({
    id: a.id, nome: a.data.nome, subgenero: a.data.subgenero,
  })),
  cenarios: (await getCollection('cenarios')).map((c) => ({
    id: c.id, nome: c.data.titulo, subgenero: c.data.subgenero, singular: c.data.singular,
  })),
  elementos: (await getCollection('elementos')).map((e) => ({
    id: e.id, nome: e.data.titulo, subgenero: e.data.subgenero,
  })),
};

// Rótulo fixo de cada carta — não depende do sorteio, por isso é escrito em
// build, diferente de {etiqueta} e {nome}, que o script preenche a cada rolagem.
const CARTAS = [
  { tipo: 'arquetipo', rotulo: 'Arquétipo' },
  { tipo: 'cenario', rotulo: 'Cenário' },
  { tipo: 'elemento', rotulo: 'Elemento narrativo' },
] as const;
---
<Base titulo="Gerador">
  <h1>Gerador de combinações</h1>

  <OpcoesDoSorteio />

  <section id="cartas" class="pilha-cartas bloco" aria-live="polite" aria-label="Peças sorteadas">
    {CARTAS.map(({ tipo, rotulo }) => <CartaSorteada tipo={tipo} rotulo={rotulo} />)}
    <div class="acoes">
      <button type="button" class="botao botao--principal" id="sortear">Gerar</button>
    </div>
  </section>

  <section class="bloco bloco-premissa" aria-labelledby="premissa-titulo">
    <h2 id="premissa-titulo">Premissa</h2>
    {/* aria-live no parágrafo, e não na seção inteira: na seção, cada clique
        em Gerar faria o leitor de tela reler também o título e os botões. */}
    <p id="premissa" class="abertura" aria-live="polite"></p>
    <div class="acoes">
      <button type="button" class="botao" id="copiar-premissa">Copiar premissa</button>
    </div>
    <span class="aviso" id="aviso-premissa" role="status"></span>
  </section>

  <section class="bloco bloco-prompt" aria-labelledby="prompt-titulo">
    <h2 id="prompt-titulo">Crie enredos com sua IA favorita</h2>
    {/* Sem aria-live, ao contrário da premissa: são cerca de trezentas palavras,
        e relê-las a cada clique em Gerar tornaria a página impraticável com
        leitor de tela. Quem quiser o texto chega nele navegando. */}
    <p id="prompt" class="prompt__texto"></p>
    <div class="acoes">
      <button type="button" class="botao" id="copiar-prompt">Copiar prompt</button>
    </div>
    <span class="aviso" id="aviso-prompt" role="status"></span>
  </section>

  {/* O {' '} é necessário: o Astro descarta o espaço em branco entre o texto e a
      tag, e sem ele sai "fechada?Monte uma ficha". */}
  <p class="outro-modo">
    Prefere as peças soltas, em vez de uma frase fechada?{' '}
    <a href={`${raiz}ficha/`}>Monte uma ficha de história</a>.
  </p>

  {/* is:inline porque isto é dado, não código: sem a diretiva o Astro trata o
      bloco como script a processar e emite um aviso em `npm run check`. */}
  <script type="application/json" id="pools" is:inline set:html={JSON.stringify(pools)}></script>
  <script type="application/json" id="modelo-prompt" is:inline set:html={JSON.stringify(modeloDoPrompt.body)}></script>
  <script type="application/json" id="nomes-dos-mundos" is:inline set:html={JSON.stringify(nomesDosMundos)}></script>
</Base>

<style>
  /* O fieldset das opções, a carta e o cadeado saíram daqui: viraram
     OpcoesDoSorteio.astro e CartaSorteada.astro, compartilhados com /ficha/.
     .pilha-cartas, .acoes e .aviso foram para global.css pelo mesmo motivo.
     O que sobrou neste arquivo é só o que é da premissa e do prompt. */

  .bloco-premissa #premissa {
    min-height: 1.6em;
    font-size: 1.15rem;
    color: var(--texto-forte);
  }

  /* pre-wrap, e não <pre>: qualquer quebra de linha que o prompt-ia.md tiver
     faz parte do texto que vai para a IA e precisa aparecer na tela igual, mas
     isto é texto para ler, não código — nada de fonte monoespaçada nem moldura.
     O modelo de hoje é um parágrafo só, sem quebras, e então pre-wrap se
     comporta como quebra normal; ele existe para o dia em que voltar a ter. */
  .prompt__texto {
    margin: 0;
    white-space: pre-wrap;
    line-height: 1.5;
  }

  /* O link para o outro modo do gerador, no fim da página: quem chegou até aqui
     já viu a premissa e o prompt, e é o momento de oferecer a alternativa. A
     ficha também está na navegação; este link continua porque a troca entre os
     dois modos é o passo natural de quem acabou de ler um deles, e o fim da
     página é onde esse passo acontece. */
  .outro-modo {
    margin: 32px 0 0;
    text-align: center;
  }
</style>

<script>
  import { montarPrompt, nomearMundos, sortear, redigir, MOLDES } from '../lib/gerador';
  import type { Opcoes, Pools, Sorteio, Travas } from '../lib/gerador';

  const pools: Pools = JSON.parse(document.getElementById('pools')!.textContent!);
  const modeloDoPrompt: string = JSON.parse(document.getElementById('modelo-prompt')!.textContent!);
  const nomesDosMundos: Record<string, string> = JSON.parse(
    document.getElementById('nomes-dos-mundos')!.textContent!,
  );
  const form = document.getElementById('opcoes') as HTMLFormElement;
  const premissa = document.getElementById('premissa')!;
  const prompt = document.getElementById('prompt')!;

  const travas: Travas = { arquetipo: false, cenario: false, elemento: false };

  // Único estado guardado do gerador, e vive só em memória: nada é escrito no
  // navegador (sem localStorage, sem conta, sem link compartilhável), por
  // decisão de projeto de gerador efêmero.
  let atual: Sorteio | null = null;

  const lerOpcoes = (): Opcoes => {
    const dados = new FormData(form);
    return {
      subgenero: String(dados.get('subgenero')),
      misturarMundos: dados.get('misturarMundos') === 'on',
      incluirComuns: dados.get('incluirComuns') === 'on',
    };
  };

  const moldeAoAcaso = () => MOLDES[Math.floor(Math.random() * MOLDES.length)];

  function pintar(sorteio: Sorteio, molde: string, opcoes: Opcoes) {
    for (const tipo of ['arquetipo', 'cenario', 'elemento'] as const) {
      const carta = document.querySelector(`[data-carta="${tipo}"]`)!;
      const peca = sorteio[tipo];
      carta.querySelector('[data-papel="nome"]')!.textContent = peca.nome;
      carta.querySelector('[data-papel="etiqueta"]')!.textContent = peca.subgenero.replace(/-/g, ' ');
    }
    premissa.textContent = redigir(sorteio, molde);
    prompt.textContent = montarPrompt(modeloDoPrompt, {
      mundo: nomearMundos(sorteio, opcoes, nomesDosMundos),
      arquetipo: sorteio.arquetipo.nome,
      cenario: sorteio.cenario.nome,
      elemento: sorteio.elemento.nome,
    });
  }

  function rolar() {
    const opcoes = lerOpcoes();
    atual = sortear(pools, opcoes, travas, atual, Math.random);
    pintar(atual, moldeAoAcaso(), opcoes);
  }

  document.getElementById('sortear')!.addEventListener('click', rolar);

  /* A mensagem de sucesso vem pronta em vez de ser montada com o nome da peça:
     "premissa" é feminino e "prompt" é masculino, e montar a frase aqui daria
     "Prompt copiada". */
  async function copiar(texto: string, aviso: HTMLElement, sucesso: string) {
    if (!texto) return;
    try {
      await navigator.clipboard.writeText(texto);
      aviso.textContent = sucesso;
    } catch {
      aviso.textContent = 'Não foi possível copiar automaticamente.';
    }
    setTimeout(() => { aviso.textContent = ''; }, 2000);
  }

  const avisoDaPremissa = document.getElementById('aviso-premissa')!;
  const avisoDoPrompt = document.getElementById('aviso-prompt')!;

  document.getElementById('copiar-premissa')!.addEventListener('click', () => {
    copiar(premissa.textContent ?? '', avisoDaPremissa, 'Premissa copiada.');
  });

  document.getElementById('copiar-prompt')!.addEventListener('click', () => {
    copiar(prompt.textContent ?? '', avisoDoPrompt, 'Prompt copiado.');
  });

  for (const botao of document.querySelectorAll<HTMLButtonElement>('[data-travar]')) {
    botao.addEventListener('click', () => {
      const tipo = botao.dataset.travar as keyof Travas;
      travas[tipo] = !travas[tipo];
      // aria-pressed é o estado inteiro: o CSS troca o cadeado aberto pelo
      // fechado a partir dele. Nada de mexer no conteúdo do botão aqui —
      // escrever textContent apagaria os dois SVGs de dentro dele.
      botao.setAttribute('aria-pressed', String(travas[tipo]));
    });
  }

  // Trocar de mundo (ou qualquer opção do formulário) zera o sorteio
  // anterior: sem isto, uma peça travada do mundo antigo sobreviveria e
  // contradiria a opção recém-escolhida. Como sortear() só respeita uma
  // trava quando existe um sorteio anterior, zerar `atual` força as três
  // peças a serem redesenhadas dentro do novo filtro. As travas em si
  // também precisam zerar aqui: sortear() já ignora travas.* quando não
  // há `anterior`, então as três peças saem corretas mesmo sem este
  // trecho — mas sem ele os cadeados continuavam fechados, com
  // aria-pressed="true", para peças que na verdade não estão mais travadas,
  // o que confunde tanto visualmente quanto para quem usa leitor de tela.
  form.addEventListener('change', () => {
    atual = null;
    for (const tipo of ['arquetipo', 'cenario', 'elemento'] as const) {
      travas[tipo] = false;
      const botao = document.querySelector<HTMLButtonElement>(`[data-travar="${tipo}"]`)!;
      botao.setAttribute('aria-pressed', 'false');
    }
    rolar();
  });

  rolar();
</script>
