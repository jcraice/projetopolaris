---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cartao from '../../components/Cartao.astro';
import { paraAncora } from '../../lib/texto';

// O pool "20 Arquétipos Comuns" tem mundo: false — não é um mundo, então não
// entra aqui. As seis páginas de mundo são as únicas geradas por esta rota.
export async function getStaticPaths() {
  const subgeneros = await getCollection('subgeneros', (s) => s.data.mundo);
  return subgeneros.map((s) => ({ params: { subgenero: s.id }, props: { subgenero: s } }));
}

const { subgenero } = Astro.props;

// Esta página é a porta de entrada de um mundo, não o catálogo dele: mostra uma
// amostra de cada tipo e manda para a página completa. Antes listava tudo, o
// que deixava o "Ver todos" sem sentido — ele levava para a mesma coisa que já
// estava na tela, depois de dezenas de verbetes de rolagem.
const PREVIA = 3;

const porOrdem = (a: { data: { ordem: number } }, b: { data: { ordem: number } }) =>
  a.data.ordem - b.data.ordem;

// O arquétipo felino fica de fora da amostra e aparece só na página completa:
// ele é o vigésimo primeiro de cada mundo, não um dos três primeiros.
const arquetipos = (await getCollection('arquetipos', (a) => a.data.subgenero === subgenero.id && !a.data.felino))
  .sort(porOrdem)
  .slice(0, PREVIA);

const cenarios = (await getCollection('cenarios', (c) => c.data.subgenero === subgenero.id))
  .sort(porOrdem)
  .slice(0, PREVIA);

const elementos = (await getCollection('elementos', (e) => e.data.subgenero === subgenero.id))
  .sort(porOrdem)
  .slice(0, PREVIA);

const livros = (await getCollection('livros', (l) => l.data.subgenero === subgenero.id))
  .sort(porOrdem)
  .slice(0, PREVIA);
// Cada livro tem vários parágrafos (edição, comentário, sinopse) — precisa de render()
// de verdade, diferente das outras coleções, que são prosa de um parágrafo só.
const livrosRenderizados = await Promise.all(
  livros.map(async (l) => ({ entrada: l, Content: (await render(l)).Content })),
);

const base = import.meta.env.BASE_URL;
const raiz = base.endsWith('/') ? base : `${base}/`;
---
<Base titulo={`Mundo ${subgenero.data.nome}`} aurora={subgenero.data.aurora}>
  <h1>{subgenero.data.nome}</h1>
  <p class="abertura">{subgenero.body}</p>

  <nav class="sumario" aria-label="Sumário do mundo">
    <a href="#arquetipos">Arquétipos</a>
    <a href="#cenarios">Cenários</a>
    <a href="#elementos">Elementos Narrativos</a>
    <a href="#livros">Livros</a>
  </nav>

  <section id="arquetipos" aria-labelledby="arquetipos-titulo">
    <div class="titulo-linha">
      <h2 id="arquetipos-titulo">Arquétipos</h2>
      <a class="ver-tudo" href={`${raiz}arquetipos/${subgenero.id}/`}>Ver todos →</a>
    </div>
    {arquetipos.map((f) => (
      <Cartao titulo={f.data.nome} ancora={`arquetipos-${paraAncora(f.data.nome)}`}>
        <p>{f.body}</p>
      </Cartao>
    ))}
  </section>

  <section id="cenarios" aria-labelledby="cenarios-titulo">
    <div class="titulo-linha">
      <h2 id="cenarios-titulo">Cenários</h2>
      <a class="ver-tudo" href={`${raiz}cenarios/${subgenero.id}/`}>Ver todos →</a>
    </div>
    {cenarios.map((c) => (
      <Cartao titulo={c.data.titulo} ancora={`cenarios-${paraAncora(c.data.titulo)}`}>
        <p>{c.body}</p>
      </Cartao>
    ))}
  </section>

  <section id="elementos" aria-labelledby="elementos-titulo">
    <div class="titulo-linha">
      <h2 id="elementos-titulo">Elementos Narrativos</h2>
      <a class="ver-tudo" href={`${raiz}elementos/${subgenero.id}/`}>Ver todos →</a>
    </div>
    {elementos.map((e) => (
      <Cartao titulo={e.data.titulo} ancora={`elementos-${paraAncora(e.data.titulo)}`}>
        <p>{e.body}</p>
      </Cartao>
    ))}
  </section>

  <section id="livros" aria-labelledby="livros-titulo">
    <div class="titulo-linha">
      <h2 id="livros-titulo">Livros</h2>
      <a class="ver-tudo" href={`${raiz}livros/${subgenero.id}/`}>Ver todos →</a>
    </div>
    {livrosRenderizados.map(({ entrada, Content }) => (
      <Cartao titulo={entrada.data.titulo} ancora={`livros-${paraAncora(entrada.data.titulo)}`}>
        <p class="autor">{entrada.data.autor}</p>
        <Content />
      </Cartao>
    ))}
  </section>

  {subgenero.data.citacao && (
    <blockquote>{subgenero.data.citacao}<cite>{subgenero.data.citacaoAutor}</cite></blockquote>
  )}
</Base>

<style>
  .sumario {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-block: 20px 32px;
  }

  .sumario a {
    color: var(--texto);
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    border-bottom: 2px solid var(--apoio);
  }

  .sumario a:hover {
    color: var(--destaque);
    border-color: var(--destaque);
  }

  section + section {
    margin-block-start: 40px;
  }

  /* As quatro seções são alvo do sumário logo acima. Sem folga, o <h2> para
     debaixo da barra fixa do topo. Os mesmos 96px do scroll-margin-top dos
     verbetes em Cartao.astro, pelo mesmo motivo: a barra recolhida tem cerca de
     68px e o resto é respiro. */
  section[id] {
    scroll-margin-top: 96px;
  }

  /* A linha do título: a pastilha e o "Ver todos" alinhados pela base. O link
     está fora do <h2>, e não dentro como antes, por causa do preenchimento —
     em --apagado sobre --destaque ele daria 2,01:1 no escuro e 1,09:1 no claro.
     É a mesma reprovação que tirou o roxo-sobre-amarelo de cogitação, e em grau
     pior, porque aqui é texto pequeno. Fora da pastilha ele continua sobre o
     céu, onde sempre esteve, e o número dele não muda. */
  .titulo-linha {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* O título de seção é uma pastilha preenchida, não texto claro: em
     --texto-forte ele ficava igual aos títulos dos verbetes logo abaixo, que
     também são claros, e a página inteira lia como um bloco só.

     inline-flex para a pastilha abraçar o texto — em `flex` ela atravessaria a
     coluna de 1280px inteira. O par de cores é o mesmo do .botao--principal e
     da .etiqueta: preenchimento em --destaque, letra em --fundo, 12,22:1 no
     escuro e 5,12:1 no claro. A sombra deslocada em --apoio traz a segunda cor
     sem carregar texto, então não responde a mínimo de contraste.
     Contas em docs/verificacao-visual.md.

     O espaço interno é maior que os 8px 14px do .botao porque a letra aqui tem
     24px contra os ~16px de um botão; com o padding do botão a pastilha ficava
     apertada em volta da caixa alta.

     A sombra fica nos dois temas, e isto é exceção deliberada: global.css tira
     a sombra deslocada do .botao no claro, por ela ser recurso de pôster que
     pesa sobre fundo claro. Aqui a autora pediu para manter, para a pastilha
     ter a mesma forma nos dois temas. Não conflita na tela porque a página de
     mundo não renderiza nenhum .botao — não há sombra ausente ao lado desta
     para destoar. Sendo cor por papel, no claro ela sai azul-tinta. */
  h2 {
    display: inline-flex;
    background: var(--destaque);
    color: var(--fundo);
    padding: 10px 16px;
    border-radius: var(--raio);
    box-shadow: 4px 4px 0 var(--apoio);
  }

  .ver-tudo {
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--apagado);
    text-transform: none;
    font-weight: 700;
  }

  .ver-tudo:hover {
    color: var(--destaque);
  }
</style>
