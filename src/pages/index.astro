---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { paragrafoComPrefixo } from '../lib/texto';

// Reaproveita dois parágrafos já escritos em Sobre (src/content/paginas/sobre.md)
// em vez de redigir uma apresentação nova — ver relatório da Task 8 para a origem.
const sobre = await getEntry('paginas', 'sobre');
if (!sobre) throw new Error("página 'sobre' não encontrada em src/content/paginas");
const apresentacao = paragrafoComPrefixo(sobre.body ?? '', 'Meu desejo');
const chamadaGerador = paragrafoComPrefixo(sobre.body ?? '', 'O gerador, que já foi só um plano');

// A busca é por prefixo, então basta alguém reescrever a primeira linha de um
// parágrafo em sobre.md para a home perder o texto sem avisar ninguém. Quebrar
// o build é melhor que publicar uma seção vazia.
for (const [nome, paragrafo] of Object.entries({ apresentacao, chamadaGerador })) {
  if (!paragrafo) {
    throw new Error(
      `parágrafo "${nome}" não encontrado em src/content/paginas/sobre.md — ` +
        'confira se o prefixo procurado em index.astro ainda casa com o texto',
    );
  }
}

const mundos = (await getCollection('subgeneros', (s) => s.data.mundo)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);

const base = import.meta.env.BASE_URL;
const raiz = base.endsWith('/') ? base : `${base}/`;

// As descrições são resumos das aberturas de src/content/paginas/{arquetipos,
// cenarios,elementos}.md — curtas o bastante para caber num cartão, e escritas
// para dizer o que cada pilar é a quem chega pela primeira vez.
const pilares = [
  {
    titulo: 'Arquétipos',
    descricao: 'Personagens de partida: papéis, conflitos e riscos para roubar e vestir com o seu estilo.',
    href: `${raiz}arquetipos`,
  },
  {
    titulo: 'Cenários',
    descricao: 'Mais que pano de fundo: espaços que moldam a trama, os personagens e os dilemas.',
    href: `${raiz}cenarios`,
  },
  {
    titulo: 'Elementos Narrativos',
    descricao: 'Temas, conflitos, tecnologias e estruturas sociais que definem o tom de cada subgênero.',
    href: `${raiz}elementos`,
  },
];
---
<Base titulo="Projeto Polaris">
  <h1>Projeto Polaris</h1>
  {apresentacao && <p class="abertura">{apresentacao}</p>}
  <p><a href={`${raiz}sobre`}>Leia a história completa em Sobre →</a></p>

  <section aria-labelledby="pilares-titulo">
    <h2 id="pilares-titulo">Comece por aqui</h2>
    <div class="pilares">
      {pilares.map((p) => (
        <a class="pilar" href={p.href}>
          <h3>{p.titulo}</h3>
          <p>{p.descricao}</p>
        </a>
      ))}
    </div>
  </section>

  <section aria-labelledby="mundos-titulo">
    <h2 id="mundos-titulo">Os mundos</h2>
    {/* Mesmo mecanismo do menu da navegação: nasce escondido, só aparece por
        JavaScript, e sem script a lista dos seis fica visível como antes. */}
    <button
      type="button"
      class="abrir-mundos"
      id="abrir-mundos"
      hidden
      aria-expanded="false"
      aria-controls="lista-mundos"
    >
      Escolher um mundo
    </button>
    <ul class="lista-subgeneros" id="lista-mundos">
      {mundos.map((m) => (
        <li>
          <a href={`${raiz}mundos/${m.id}/`}>{m.data.nome}</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="cta-gerador" aria-labelledby="gerador-titulo">
    <h2 id="gerador-titulo">Gerador de Combinações</h2>
    {chamadaGerador && <p>{chamadaGerador}</p>}
    <a class="botao botao--principal" href={`${raiz}gerador`}>Ir para o Gerador</a>
  </section>
</Base>

<style>
  section + section {
    margin-block-start: 40px;
  }

  .pilares {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .pilar {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    min-width: 220px;
    flex: 1 1 220px;
    background: var(--painel);
    border: 2px solid var(--destaque);
    padding: 16px;
    text-decoration: none;
  }

  .pilar h3 {
    margin: 0;
    color: var(--texto);
  }

  .pilar p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--texto);
  }

  .pilar:hover h3 {
    color: var(--destaque);
  }

  /* No claro o pilar é preenchido com --destaque, que já era a cor da borda
     dele, e o hover inverte para --apoio. Título e descrição ficam na cor do
     fundo da página nos dois estados: 5,52:1 sobre o ciano e 13,24:1 sobre o
     azul-tinta. */
  :global(html[data-tema='claro']) .pilar {
    background: var(--destaque);
    border-color: var(--destaque);
  }

  :global(html[data-tema='claro']) .pilar h3,
  :global(html[data-tema='claro']) .pilar p,
  :global(html[data-tema='claro']) .pilar:hover h3 {
    color: var(--fundo);
  }

  :global(html[data-tema='claro']) .pilar:hover {
    background: var(--apoio);
    border-color: var(--apoio);
  }

  /* Os seis retângulos de mundo viram uma lista que abre em tela estreita.

     O ponto de quebra é o mesmo 1079px da navegação, e não por simetria: os
     seis nomes somam cerca de 1060px com o espaço entre eles — "Invasão
     Alienígena" e "Pós Apocalíptico" são largos — então é por volta daí que
     eles passariam para uma segunda linha. Recolher antes disso é o que evita
     vê-los quebrados no caminho até o celular. */
  .abrir-mundos {
    display: none;
    align-items: center;
    gap: 8px;
    border: 2px solid var(--apoio);
    background: transparent;
    /* Mesmo par dos retângulos que este botão abre: traço de --apoio, rótulo em
       --texto. Escrever o rótulo em --apoio, como fazem os outros botões,
       daria 2,34:1 sobre o céu — o traço pode ser discreto, o rótulo não. */
    color: var(--texto);
    font-family: inherit;
    font-weight: 800;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 10px 14px;
    cursor: pointer;
  }

  :global(html[data-tema='claro']) .abrir-mundos {
    background: var(--apoio);
    color: var(--fundo);
  }

  .abrir-mundos::after {
    content: '▾';
  }

  .abrir-mundos[aria-expanded='true']::after {
    content: '▴';
  }

  .abrir-mundos:focus-visible {
    outline: 3px solid var(--apoio);
    outline-offset: 3px;
  }

  .abrir-mundos[hidden] {
    display: none;
  }

  @media (max-width: 1079px) {
    .abrir-mundos:not([hidden]) {
      display: inline-flex;
    }

    .abrir-mundos:not([hidden]) ~ .lista-subgeneros {
      display: none;
    }

    .abrir-mundos[aria-expanded='true'] ~ .lista-subgeneros {
      display: flex;
      flex-direction: column;
      margin-top: 12px;
    }
  }

  .cta-gerador {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    border-left: 3px solid var(--apoio);
    padding-left: 16px;
  }
</style>

<script>
  import { ligarExpansivel } from '../lib/expansivel';

  ligarExpansivel(document.getElementById('abrir-mundos'));
</script>
