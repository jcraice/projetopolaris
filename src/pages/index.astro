---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const pagina = await getEntry('paginas', 'home');
if (!pagina) throw new Error("página 'home' não encontrada em src/content/paginas");

// A home depende dos três: subtítulo abaixo do título, chamada dentro do card
// do gerador, citação no fim. Falhar alto aqui é melhor que uma página com um
// buraco silencioso onde deveria haver frase.
for (const campo of ['subtitulo', 'chamadaGerador', 'citacao'] as const) {
  if (!pagina.data[campo]) {
    throw new Error(`campo '${campo}' ausente em src/content/paginas/home.md`);
  }
}

const { Content } = await render(pagina);

const mundos = (await getCollection('subgeneros', (s) => s.data.mundo)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);

const base = import.meta.env.BASE_URL;
const raiz = base.endsWith('/') ? base : `${base}/`;

// As descrições são resumos das aberturas de src/content/paginas/{arquetipos,
// cenarios,elementos}.md — curtas o bastante para caber num cartão, e escritas
// para dizer o que cada pilar é a quem chega pela primeira vez.
const pilares = [
  {
    titulo: 'Arquétipos',
    descricao: 'Personagens de partida: papéis, conflitos e riscos para roubar e vestir com o seu estilo.',
    href: `${raiz}arquetipos`,
  },
  {
    titulo: 'Cenários',
    descricao: 'Mais que pano de fundo: espaços que moldam a trama, os personagens e os dilemas.',
    href: `${raiz}cenarios`,
  },
  {
    titulo: 'Elementos Narrativos',
    descricao: 'Temas, conflitos, tecnologias e estruturas sociais que definem o tom de cada subgênero.',
    href: `${raiz}elementos`,
  },
];
---
<Base titulo="Início">
  <h1>{pagina.data.titulo}</h1>
  <p class="subtitulo">{pagina.data.subtitulo}</p>
  <div class="conteudo">
    <Content />
  </div>

  <div class="pilares">
    {pilares.map((p) => (
      <a class="pilar" href={p.href}>
        <h2>{p.titulo}</h2>
        <p>{p.descricao}</p>
      </a>
    ))}
  </div>

  <section aria-labelledby="mundos-titulo">
    <h2 id="mundos-titulo">Os mundos</h2>
    {/* Mesmo mecanismo do menu da navegação: nasce escondido, só aparece por
        JavaScript, e sem script a lista dos seis fica visível como antes. */}
    <button
      type="button"
      class="abrir-mundos"
      id="abrir-mundos"
      hidden
      aria-expanded="false"
      aria-controls="lista-mundos"
    >
      Escolher um mundo
    </button>
    <ul class="lista-subgeneros" id="lista-mundos">
      {mundos.map((m) => (
        <li>
          <a href={`${raiz}mundos/${m.id}/`}>{m.data.nome}</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="cta-gerador" aria-labelledby="gerador-titulo">
    <h2 id="gerador-titulo">Gerador de Combinações</h2>
    <p>{pagina.data.chamadaGerador}</p>
    <a class="botao botao--principal" href={`${raiz}gerador`}>Ir para o Gerador</a>
  </section>

  <blockquote>{pagina.data.citacao}</blockquote>
</Base>

<style>
  /* Depois que os cards perderam o <section> que os embrulhava, sobrou um só
     intervalo governado por regra e o resto caiu na margem padrão do navegador.
     Estas quatro combinações são as fronteiras de verdade da página. */
  .conteudo + .pilares,
  .pilares + section,
  section + section,
  section + blockquote {
    margin-block-start: 40px;
  }

  /* 1.2rem e não menos, pela mesma razão dos títulos de verbete: sobre o céu o
     --destaque fica em 4,27:1 no pior mundo, abaixo dos 4,5 que texto pequeno
     exige, mas a partir de 18,66px em negrito o WCAG trata como texto grande e
     o mínimo cai para 3:1. 1.2rem dá 19,2px. Encolher aqui reprova o contraste. */
  .subtitulo {
    margin-block: 0 24px;
    color: var(--destaque);
    font-weight: 800;
    font-size: 1.2rem;
  }

  /* O corpo vem de render() do Markdown e não recebe o atributo de escopo do
     Astro, então o alcance tem que vir do contêiner. */
  .conteudo :global(p) {
    line-height: 1.55;
  }

  /* O emoji de cada item já é o marcador; o disco do navegador em cima dele
     ficaria marcador duplicado. */
  .conteudo :global(ul) {
    list-style: none;
    padding-left: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pilares {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .pilar {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    min-width: 220px;
    flex: 1 1 220px;
    background: var(--painel);
    border: 2px solid var(--destaque);
    padding: 16px;
    text-decoration: none;
    border-radius: var(--raio);
  }

  /* Virou h2 para não pular nível de título (h1 direto para h3 sem h2 no meio) —
     o tamanho fica preso em 1.17rem, que era o que um h3 já renderizava, para a
     mudança de nível não mudar a aparência da home. */
  .pilar h2 {
    margin: 0;
    color: var(--texto);
    font-size: 1.17rem;
  }

  .pilar p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--texto);
  }

  .pilar:hover h2 {
    color: var(--destaque);
  }

  /* No claro o pilar é preenchido com --destaque, que já era a cor da borda
     dele, e o hover inverte para --apoio. Título e descrição ficam na cor do
     fundo da página nos dois estados: 5,12:1 sobre o laranja e 13,24:1 sobre o
     azul-tinta. */
  :global(html[data-tema='claro']) .pilar {
    background: var(--destaque);
    border-color: var(--destaque);
  }

  :global(html[data-tema='claro']) .pilar h2,
  :global(html[data-tema='claro']) .pilar p,
  :global(html[data-tema='claro']) .pilar:hover h2 {
    color: var(--fundo);
  }

  :global(html[data-tema='claro']) .pilar:hover {
    background: var(--apoio);
    border-color: var(--apoio);
  }

  /* Os seis retângulos de mundo viram uma lista que abre em tela estreita.

     O ponto de quebra sai do conteúdo desta lista, e não da navegação: os seis
     nomes somam cerca de 1060px com o espaço entre eles — "Invasão Alienígena" e
     "Pós Apocalíptico" são largos — então é por volta daí que eles passariam
     para uma segunda linha. Recolher antes disso é o que evita vê-los quebrados
     no caminho até o celular.

     Já foi o mesmo número da navegação, por coincidência das duas somas. Deixou
     de ser quando a navegação ganhou o link da ficha e precisou subir para
     1103px: os dois pontos de quebra são independentes, cada um medido no seu
     próprio conteúdo, e mudar um não obriga a mudar o outro. */
  .abrir-mundos {
    display: none;
    align-items: center;
    gap: 8px;
    border: 2px solid var(--apoio);
    background: transparent;
    /* Mesmo par dos retângulos que este botão abre: traço de --apoio, rótulo em
       --texto. Escrever o rótulo em --apoio, como fazem os outros botões,
       daria 2,34:1 sobre o céu — o traço pode ser discreto, o rótulo não. */
    color: var(--texto);
    font-family: inherit;
    font-weight: 800;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 10px 14px;
    cursor: pointer;
    border-radius: var(--raio);
  }

  :global(html[data-tema='claro']) .abrir-mundos {
    background: var(--apoio);
    color: var(--fundo);
  }

  .abrir-mundos::after {
    content: '▾';
  }

  .abrir-mundos[aria-expanded='true']::after {
    content: '▴';
  }

  .abrir-mundos:focus-visible {
    outline: 3px solid var(--apoio);
    outline-offset: 3px;
  }

  .abrir-mundos[hidden] {
    display: none;
  }

  @media (max-width: 1079px) {
    .abrir-mundos:not([hidden]) {
      display: inline-flex;
    }

    .abrir-mundos:not([hidden]) ~ .lista-subgeneros {
      display: none;
    }

    .abrir-mundos[aria-expanded='true'] ~ .lista-subgeneros {
      display: flex;
      flex-direction: column;
      margin-top: 12px;
    }
  }

  /* Era uma seção com barra lateral. Virou card, com o mesmo par de contorno e
     painel dos três pilares acima, para a home ler como uma sequência de cards.

     Não recebe o preenchimento que o .pilar ganha no tema claro: o botão
     principal dentro dele também é --destaque, e um sobre o outro sumiria. */
  .cta-gerador {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    background: var(--painel);
    border: 2px solid var(--destaque);
    border-radius: var(--raio);
    padding: 16px;
  }

  .cta-gerador h2 {
    margin: 0;
  }

  .cta-gerador p {
    margin: 0;
  }
</style>

<script>
  import { ligarExpansivel } from '../lib/expansivel';

  ligarExpansivel(document.getElementById('abrir-mundos'));
</script>
