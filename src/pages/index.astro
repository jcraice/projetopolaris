---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import IconeDaCarta from '../components/IconeDaCarta.astro';
import MapaEstelar from '../components/MapaEstelar.astro';
import { contagem } from '../lib/texto';

const pagina = await getEntry('paginas', 'home');
if (!pagina) throw new Error("página 'home' não encontrada em src/content/paginas");

// A home depende dos três: subtítulo abaixo do título, chamada do gerador,
// citação no fim. Falhar alto aqui é melhor que uma página com um buraco
// silencioso onde deveria haver frase.
for (const campo of ['subtitulo', 'chamadaGerador', 'citacao'] as const) {
  if (!pagina.data[campo]) {
    throw new Error(`campo '${campo}' ausente em src/content/paginas/home.md`);
  }
}

// Um ícone por posição: o Como usar tem de ter exatamente os quatro passos que
// os desenhos acompanham. Passo a mais ficaria sem ícone, e a falta de um
// deixaria o desenho de outro passo no lugar errado.
const ICONES = ['bussola', 'carta', 'constelacao', 'estrela'] as const;
const comoUsar = pagina.data.comoUsar ?? [];
if (comoUsar.length !== ICONES.length) {
  throw new Error(`src/content/paginas/home.md precisa de ${ICONES.length} passos em comoUsar, tem ${comoUsar.length}`);
}

const { Content } = await render(pagina);

// O tamanho do acervo contado das coleções, e não escrito à mão: é o número
// que mais envelhece em silêncio no site (ver CLAUDE.md).
const [arquetipos, cenarios, elementos] = await Promise.all([
  getCollection('arquetipos'),
  getCollection('cenarios'),
  getCollection('elementos'),
]);

const subgeneros = (await getCollection('subgeneros', (s) => s.data.completo)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);

const base = import.meta.env.BASE_URL;
const raiz = base.endsWith('/') ? base : `${base}/`;

// O título de home.md é "Projeto Polaris: Arquétipos da Ficção Científica".
// A barra do topo já diz Polaris, então a página mostra o que vem depois dos
// dois-pontos, com as duas últimas palavras em itálico laranja — o recorte é
// daqui e não do Markdown, para a autora não ter de escrever marcação no
// título.
const [, depoisDosDoisPontos = pagina.data.titulo] = pagina.data.titulo.split(': ');
const palavras = depoisDosDoisPontos.split(' ');
const realce = palavras.slice(-2).join(' ');
const inicio = palavras.slice(0, -2).join(' ');

// As descrições são resumos das aberturas de src/content/paginas/{arquetipos,
// cenarios,elementos}.md — curtas o bastante para caber numa coluna, e escritas
// para dizer o que cada caminho é a quem chega pela primeira vez.
const pilares = [
  {
    titulo: 'Arquétipos',
    descricao: 'Personagens de partida: papéis, conflitos e riscos para roubar e vestir com o seu estilo.',
    href: `${raiz}arquetipos`,
  },
  {
    titulo: 'Cenários',
    descricao: 'Mais que pano de fundo: espaços que moldam a trama, os personagens e os dilemas.',
    href: `${raiz}cenarios`,
  },
  {
    titulo: 'Elementos Narrativos',
    descricao: 'Temas, conflitos, tecnologias e estruturas sociais que definem o tom de cada subgênero.',
    href: `${raiz}elementos`,
  },
];

const acervo = [
  contagem(subgeneros.length, 'subgênero', 'subgêneros'),
  contagem(arquetipos.length, 'arquétipo', 'arquétipos'),
  contagem(cenarios.length, 'cenário', 'cenários'),
  contagem(elementos.length, 'elemento', 'elementos'),
].map((texto) => {
  const [numero, ...resto] = texto.split(' ');
  return { numero, rotulo: resto.join(' ') };
});

const destinos = subgeneros.map((m) => ({ nome: m.data.nome, href: `${raiz}subgeneros/${m.id}/` }));
---
<Base titulo="Início">
  <div class="abertura-home">
    <div class="abertura-home__texto">
      {/* As coordenadas reais da Polaris (época J2000). */}
      <p class="rotulo">AR 02h 31m 49s · DEC +89° 15′ 51″</p>
      <h1>{inicio} <em>{realce}</em></h1>
      <p class="subtitulo">{pagina.data.subtitulo}</p>
      <a class="botao botao--principal" href={`${raiz}gerador`}>Gerar uma premissa</a>
    </div>
    <MapaEstelar subgeneros={destinos} />
  </div>

  {/* A fileira de subgêneros só aparece no celular, onde o mapa perde os
      nomes. Acima disso é o mapa que leva aos subgêneros. */}
  <nav class="subgeneros-celular" aria-label="Subgêneros">
    <ul class="lista-subgeneros">
      {destinos.map((d) => (
        <li><a href={d.href}>{d.nome}</a></li>
      ))}
    </ul>
  </nav>

  <div class="pilares">
    {pilares.map((p) => (
      <a class="pilar" href={p.href}>
        <h2>{p.titulo}</h2>
        <p>{p.descricao}</p>
      </a>
    ))}
  </div>

  {/* A apresentação é a legenda da carta: letra grande, com o tamanho do
      acervo numa coluna ao lado. */}
  <section class="sobre" aria-labelledby="sobre-titulo">
    <h2 class="rotulo" id="sobre-titulo">Sobre o acervo</h2>
    <div class="sobre__grade">
      <div class="conteudo">
        <Content />
      </div>
      <dl class="acervo">
        {acervo.map((a) => (
          <div>
            <dt>{a.rotulo}</dt>
            <dd>{a.numero}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="como-usar" aria-labelledby="como-usar-titulo">
    <h2 class="rotulo" id="como-usar-titulo">Como usar</h2>
    <ul class="passos">
      {comoUsar.map((passo, i) => (
        <li class="passo">
          <IconeDaCarta nome={ICONES[i]} />
          <h3>{passo.titulo}</h3>
          <p>{passo.texto}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="cta-gerador" aria-labelledby="gerador-titulo">
    <h2 id="gerador-titulo">Gerador de Combinações</h2>
    <p>{pagina.data.chamadaGerador}</p>
    <a class="botao botao--principal" href={`${raiz}gerador`}>Ir para o Gerador</a>
  </section>

  <blockquote>{pagina.data.citacao}</blockquote>
</Base>

<style>
  .abertura-home {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 40px;
    align-items: center;
    padding-block: 24px 16px;
  }

  /* Texto grande: 6,22:1 no escuro e 4,95:1 no claro. */
  h1 em {
    font-style: italic;
    color: var(--destaque);
  }

  .subtitulo {
    margin-block: 0 24px;
    color: var(--apagado);
    font-size: 1.05rem;
    max-width: 42ch;
  }

  .subgeneros-celular {
    display: none;
  }

  .pilares,
  .sobre,
  .como-usar,
  .cta-gerador,
  blockquote {
    margin-block-start: 48px;
  }

  /* Os três caminhos em colunas de atlas: sem moldura nem fundo, separados por
     linha fina. Eram cartões com contorno em --destaque até a Carta
     Estelar. */
  .pilares {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--borda-suave);
  }

  .pilar {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 24px 20px 0;
    text-decoration: none;
    color: var(--texto);
  }

  .pilar + .pilar {
    padding-left: 24px;
    border-left: 1px solid var(--borda-suave);
  }

  .pilar h2 {
    margin: 0;
    font-size: 1.35rem;
  }

  .pilar p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--apagado);
  }

  .pilar:hover h2 {
    color: var(--destaque);
  }

  /* A legenda da carta: a apresentação em Fraunces grande. O corpo vem de
     render() do Markdown e não recebe o atributo de escopo do Astro, então o
     alcance tem que vir do contêiner. */
  .sobre__grade {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .conteudo :global(p) {
    margin: 0;
    font-family: var(--fonte-titulo);
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
    line-height: 1.45;
    color: var(--texto-forte);
  }

  /* Texto grande: 6,22:1 no escuro e 4,95:1 no claro. */
  .conteudo :global(em) {
    color: var(--destaque);
  }

  /* O número em cima e o nome embaixo, embora o <dt> venha antes no HTML:
     quem lê em voz alta ouve "subgêneros: 10", e o olho vê o número primeiro. */
  .acervo {
    display: grid;
    gap: 14px;
    margin: 0;
    padding-left: 24px;
    border-left: 1px solid var(--borda-suave);
  }

  .acervo div {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
  }

  .acervo dd {
    margin: 0;
    font-family: var(--fonte-titulo);
    font-size: 2rem;
    line-height: 1;
    color: var(--texto-forte);
    font-variant-numeric: tabular-nums;
  }

  .acervo dt {
    font-family: var(--fonte-rotulo);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--apagado);
  }

  /* Os quatro passos repetem as colunas com linha fina dos três caminhos lá
     em cima, cada um com o seu ícone. */
  .passos {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--borda-suave);
  }

  .passo {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 20px 4px 0;
  }

  .passo + .passo {
    padding-left: 20px;
    border-left: 1px solid var(--borda-suave);
  }

  .passo h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  .passo p {
    margin: 0;
    font-size: 0.92rem;
  }

  .cta-gerador {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding-top: 32px;
    border-top: 1px solid var(--borda-suave);
  }

  .cta-gerador h2,
  .cta-gerador p {
    margin: 0;
  }

  .cta-gerador p {
    max-width: 70ch;
  }

  @media (max-width: 900px) {
    .sobre__grade {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .acervo {
      grid-template-columns: repeat(4, auto);
      justify-content: start;
      gap: 24px;
      padding-left: 0;
      border-left: 0;
    }

    .passos {
      grid-template-columns: 1fr 1fr;
    }

    .passo:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 640px) {
    .acervo {
      grid-template-columns: 1fr 1fr;
    }

    .passos {
      grid-template-columns: 1fr;
    }

    .passo,
    .passo + .passo {
      padding: 16px 0;
      border-left: 0;
    }

    .passo + .passo {
      border-top: 1px solid var(--borda-suave);
    }

    .abertura-home {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .subgeneros-celular {
      display: block;
    }

    .pilares {
      grid-template-columns: 1fr;
    }

    .pilar,
    .pilar + .pilar {
      padding: 16px 0;
      border-left: 0;
    }

    .pilar + .pilar {
      border-top: 1px solid var(--borda-suave);
    }
  }
</style>
